<%%= render "shared/context_nav", title: t("activerecord.models.<%= class_name %>.other"), new_path: new_<%= singular_table_name %>_path do %>
<span class="breadcrumb-item active"><%%= t("activerecord.models.<%= class_name %>.other") %></span>
<%% end %>
<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h2 class="card-title"><%%= t("activerecord.models.<%= class_name %>.other") %></h2>
    <div>
      <%%= link_to new_<%= singular_table_name %>_path, class: "btn btn-sm btn-primary" do %>
      <i class="lucide-plus-circle"></i> Incluir
      <%% end %>
    </div>
  </div>
  <!-- Filtro com Ransack -->
  <div class="card-body">
    <%%= search_form_for @q, url: <%= plural_table_name %>_path, method: :get, html: { class: "mb-3" } do |f| %>
    <div class="row">
      <%- attributes_to_ignore = ['deleted_at', 'original_user_create', 'last_user_update', 'created_by', 'updated_by'] -%>
      <%- visible_attributes = attributes.reject { |a| attributes_to_ignore.include?(a.name) } -%>
      <% visible_attributes.first(2).each_with_index do |attribute, index| %>
        <div class="col-md-4">
          <%%= f.label :<%= attribute.name %>_cont, t("activerecord.attributes.<%= singular_table_name %>.<%= attribute.name %>") %>
          <%%= f.search_field :<%= attribute.name %>_cont, class: "form-control", placeholder: "Pesquisar por #{attribute.name.humanize}" %>
        </div>
      <% end %>
      <div class="col-md-4 d-flex align-items-end">
        <%%= f.submit "Filtrar", class: "btn btn-sm btn-primary me-2" %>
        <%%= link_to "Limpar", <%= plural_table_name %>_path, class: "btn btn-sm btn-secondary" if params[:q] %>
      </div>
    </div>
    <%% end %>
  </div>
  <!-- Tabela -->
  <div class="card-body">
    <div class="table-responsive" style="height: 400px; overflow-y: auto;">
      <table class="table table-sm table-bordered table-striped">
        <thead>
          <tr>
            <th class="text-center">Ações</th>
            <% visible_attributes.each do |attribute| %>
              <th><%%= sort_link(@q, :<%= attribute.name %>, t("activerecord.attributes.<%= singular_table_name %>.<%= attribute.name %>")) %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <%% @<%= plural_table_name %>.each do |<%= singular_table_name %>| %>
          <tr>
            <td class="text-center">
              <div class="dropdown">
                <a href="#" class="dropdown-toggle text-body" data-bs-toggle="dropdown" aria-expanded="false">
                  <i class="ph-gear"></i>
                </a>
                <div class="dropdown-menu">
                  <div class="dropdown-header">Opções</div>
                  <%%= link_to edit_<%= singular_table_name %>_path(<%= singular_table_name %>), class: "dropdown-item" do %>
                  <i class="ph-pen me-2"></i> Editar
                  <%% end %>
                  <%%= button_to <%= singular_table_name %>_path(<%= singular_table_name %>), method: :delete, data: { confirm: "Tem certeza que deseja excluir?" }, class: "dropdown-item text-danger" do %>
                  <i class="ph-trash-simple me-2"></i> Excluir
                  <%% end %>
                </div>
              </div>
            </td>
            <% visible_attributes.each do |attribute| %>
              <td><%%= <%= singular_table_name %>.<%= attribute.name %> %></td>
            <% end %>
          </tr>
          <%% end %>
        </tbody>
      </table>
    </div>
  </div>
  <!-- Paginação -->
  <div class="card-footer">
    <%%= pagy_bootstrap_nav(@pagy, link_extra: 'class="btn btn-outline-secondary btn-sm mx-1"').html_safe %>
  </div>
</div>
<!-- Estilo -->
<style>
  .table-responsive {
    height: 400px;
    overflow-y: auto;
  }
</style>
