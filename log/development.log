<!-- HOME SECTION -->
<section id="home" class="hero">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6 hero-content">
        <h1 class="hero-title">
          Transforme suas letras em verdadeiras obras de arte
        </h1>
        <p class="hero-subtitle lead" style="color: #0d111a">
          Recursos, cursos e inspiração para artistas de lettering que
          desejam elevar sua arte ao próximo nível.
        </p>
        <div class="d-flex gap-3">
          <%= link_to "Ver Papelaria Digital", root_path, class: "btn btn-primary btn-lg rounded-pill" %>
          <%= link_to "Explorar Cursos", root_path, class: "btn btn-light btn-lg rounded-pill" %>
        </div>
      </div>
      <div class="col-lg-6 hero-img mt-5 mt-lg-0">
        <%= image_tag "https://direitocomevellyn.com/wp-content/uploads/2024/06/prod-1.png", alt: "Lettering Art", class: "img-fluid" %>
      </div>
    </div>
  </div>
</section>
<!-- Produtos SECTION -->
<section class="py-5 bg-light">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="fw-bold">Destaques da Papelaria Digital</h2>
      <p class="text-muted">Confira alguns dos nossos produtos disponíveis</p>
    </div>
    <div class="mb-4 d-flex flex-wrap justify-content-center gap-2">
      <button class="filter-btn active">Todos</button>
      <% @g_categorias.each do |categoria| %>
        <%= link_to categoria.nome, root_path(categoria: categoria.slug), class: "filter-btn" %>
      <% end %>
    </div>
    <div class="row g-4">
      <% @i_produtos.each do |produto| %>
        <div class="col-lg-4 col-md-6">
          <div class="card h-100 product-card">
            <% if# produto.desconto.present? && produto.desconto > 0 %>
              <span class="badge bg-danger product-badge">-<%=# produto.desconto %>%</span>
            <% #elsif produto.created_at >= 30.days.ago %>
              <span class="badge bg-success product-badge">Novo</span>
            <% end %>
            <div class="product-actions">
              <a href="#" class="product-action-btn">
                <i class="lucide-heart"></i>
              </a>
              <a href="<%= i_produto_path(produto) %>" class="product-action-btn">
                <i class="lucide-eye"></i>
              </a>
            </div>
            <% if produto.imagem.attached? %>
              <%= image_tag url_for(produto.imagem), class: "card-img-top", alt: produto.nome %>
            <% else %>
              <div class="card-img-top d-flex align-items-center justify-content-center bg-light">
                <i class="lucide-image text-muted" style="font-size: 3rem;"></i>
              </div>
            <% end %>
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <% if produto.g_categoria.present? %>
                  <span class="badge bg-primary"><%= produto.g_categoria.nome %></span>
                <% else %>
                  <span class="badge bg-secondary">Geral</span>
                <% end %>
                <div class="product-rating">
                  <div class="stars">
                    <% 5.times do |i| %>
                      <% if produto.avaliacao && i < produto.avaliacao.floor %>
                        <i class="lucide-star"></i>
                      <% elsif produto.avaliacao && i < produto.avaliacao %>
                        <i class="lucide-star-half"></i>
                      <% else %>
                        <i class="lucide-star" style="opacity: 0.3;"></i>
                      <% end %>
                    <% end %>
                  </div>
                  <span class="count">(<%= produto.avaliacoes_count || rand(5..50) %>)</span>
                </div>
              </div>
              <h5 class="card-title"><%= produto.nome %></h5>
              <p class="card-text"><%= truncate(produto.descricao, length: 100) %></p>
              <div class="product-price">
                <% if produto.preco_original.present? && produto.preco_original > produto.preco %>
                  <span class="original-price">R$ <%= number_to_currency(produto.preco_original, unit: "", separator: ",", delimiter: ".") %></span>
                <% end %>
                <span>R$ <%= number_to_currency(produto.preco, unit: "", separator: ",", delimiter: ".") %></span>
              </div>
              <button class="btn btn-primary rounded-pill w-100">
                Adicionar ao Carrinho
              </button>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="mt-5">
      <%= pagy_bootstrap_nav(@pagy, link_extra: 'class="page-link"').html_safe %>
    </div>
  </div>
</section>
