80:    </header>
81:    <!-- Modal de Login -->
82:    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
83:      <div class="modal-dialog modal-dialog-centered">
84:        <div class="modal-content">
85:          <div class="modal-header border-0">
86:            <h5 class="modal-title" id="loginModalLabel">Entrar na sua conta</h5>
87:            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
88:          </div>
89:          <div class="modal-body">
90:            <div class="text-center mb-4">
91:              <%= image_tag('/layout/assets/img/LogoEstudeComEvelyn.png', alt: 'Logo', style: 'max-width: 150px;') %>
92:              <p class="mt-3 text-muted">Acesse sua conta para continuar</p>
93:            </div>
94:            <div id="login-error-message" class="alert alert-danger d-none"></div>
95:            <%= form_with(url: user_session_path, method: :post, id: "login-form", class: "login-form") do |f| %>
96:              <div class="mb-3">
97:                <%= f.label :email, "Email", class: "form-label" %>
98:                <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "seu@email.com", name: "user[email]" %>
99:              </div>
100:              <div class="mb-3">
101:                <%= f.label :password, "Senha", class: "form-label" %>
102:                <%= f.password_field :password, autocomplete: "current-password", class: "form-control", placeholder: "Sua senha", name: "user[password]" %>
103:              </div>
104:              <div class="mb-3 form-check">
105:                <%= f.check_box :remember_me, class: "form-check-input", name: "user[remember_me]", id: "user_remember_me" %>
106:                <%= f.label :remember_me, "Lembrar de mim", class: "form-check-label", for: "user_remember_me" %>
107:              </div>
108:              <div class="d-grid gap-2 mb-3">
109:                <%= f.submit "Entrar", class: "btn btn-primary rounded-pill", id: "login-button" %>
110:              </div>
111:            <% end %>
112:            <div class="text-center mt-3">
113:              <p><%= link_to "Esqueceu sua senha?", new_user_password_path, class: "text-decoration-none" %></p>
114:              <p>Não tem uma conta? <%= link_to "Cadastre-se", new_user_registration_path, class: "text-decoration-none fw-bold" %></p>
115:            </div>
116:            <% if defined?(User) && User.respond_to?(:omniauth_providers) && User.omniauth_providers.any? %>
117:              <div class="social-login mt-4">
118:                <p class="text-center text-muted mb-3">Ou entre com</p>
119:                <div class="d-flex justify-content-center gap-3">
120:                  <% if User.omniauth_providers.include?(:google_oauth2) %>
121:                    <%= link_to user_google_oauth2_omniauth_authorize_path, class: "btn btn-outline-secondary rounded-pill", method: :post do %>
122:                      <i class="lucide-google"></i> Google
123:                    <% end %>
124:                  <% end %>
125:                  <% if User.omniauth_providers.include?(:facebook) %>
126:                    <%= link_to user_facebook_omniauth_authorize_path, class: "btn btn-outline-secondary rounded-pill", method: :post do %>
127:                      <i class="lucide-facebook"></i> Facebook
128:                    <% end %>
129:                  <% end %>
130:                </div>
131:              </div>
132:            <% end %>
133:          </div>
134:        </div>
135:      </div>
136:    </div>
137:    <script>
138:      // Ativar link de navegação com base na seção visível
139:      document.addEventListener("DOMContentLoaded", function () {
140:        const sections = document.querySelectorAll("section[id]");
141:        const navLinks = document.querySelectorAll(".navbar-nav .nav-link");
142:    
143:        function highlightNavLink() {
144:          const scrollY = window.pageYOffset;
145:    
146:          sections.forEach((section) => {
147:            const sectionHeight = section.offsetHeight;
148:            const sectionTop = section.offsetTop - 100;
149:            const sectionId = section.getAttribute("id");
150:    
151:            if (scrollY > sectionTop && scrollY <= sectionTop + sectionHeight) {
152:              navLinks.forEach((link) => {
153:                link.classList.remove("active");
154:                if (link.getAttribute("href") === "#" + sectionId) {
155:                  link.classList.add("active");
156:                }
157:              });
158:            }
159:          });
160:        }
161:    
162:        window.addEventListener("scroll", highlightNavLink);
163:    
164:        // Smooth scroll para links internos
165:        document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
166:          anchor.addEventListener("click", function (e) {
167:            e.preventDefault();
168:    
169:            const targetId = this.getAttribute("href");
170:            const targetElement = document.querySelector(targetId);
171:    
172:            if (targetElement) {
173:              window.scrollTo({
174:                top: targetElement.offsetTop - 80,
175:                behavior: "smooth",
176:              });
177:            }
178:          });
179:        });
180:    
181:        // Configurar o formulário de login para usar AJAX
182:        const loginForm = document.getElementById('login-form');
183:        if (loginForm) {
184:          loginForm.addEventListener('submit', function(e) {
185:            e.preventDefault();
186:    
187:            const loginButton = document.getElementById('login-button');
188:            const errorMessage = document.getElementById('login-error-message');
189:    
190:            // Desabilitar o botão e mostrar loading
191:            loginButton.disabled = true;
192:            loginButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Entrando...';
193:    
194:            // Limpar mensagens de erro anteriores
195:            errorMessage.classList.add('d-none');
196:            errorMessage.textContent = '';
197:    
198:            // Obter o token CSRF
199:            const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
200:    
201:            // Enviar o formulário via AJAX
202:            fetch(loginForm.action, {
203:              method: 'POST',
204:              body: new FormData(loginForm),
205:              headers: {
206:                'Accept': 'application/json',
207:                'X-Requested-With': 'XMLHttpRequest',
208:                'X-CSRF-Token': csrfToken
209:              },
210:              credentials: 'same-origin'
211:            })
212:            .then(response => {
213:              if (response.ok) {
214:                return response.json().then(data => {
215:                  if (data.success) {
216:                    // Login bem-sucedido, redirecionar para o painel
217:                    window.location.href = '<%= root_path %>';
218:                  } else {
219:                    throw new Error('Falha na autenticação');
220:                  }
221:                });
222:              } else if (response.status === 401) {
223:                // Credenciais inválidas
224:                return response.json().then(data => {
225:                  throw new Error(data.error || 'Email ou senha inválidos');
226:                });
227:              } else {
228:                throw new Error('Erro no servidor');
229:              }
230:            })
231:            .catch(error => {
232:              // Mostrar mensagem de erro
233:              errorMessage.textContent = error.message || 'Ocorreu um erro ao tentar fazer login. Por favor, tente novamente.';
234:              errorMessage.classList.remove('d-none');
235:    
236:              // Resetar o botão
237:              loginButton.disabled = false;
238:              loginButton.innerHTML = 'Entrar';
239:    
240:              console.error('Erro de login:', error);
241:            });
242:          });
243:        }
244:      });
245:    </script>
  
