59:            <% if user_signed_in? %>
60:              <div class="dropdown">
61:                <button class="btn btn-primary rounded-pill d-none d-lg-block dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
62:                  <%= current_user.email.split('@').first %>
63:                </button>
64:                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
65:                  <li><%= link_to "Minha Conta", g_admin_path, class: "dropdown-item" %></li>
66:                  <li><%= link_to "Meus Pedidos", g_admin_path, class: "dropdown-item" %></li>
67:                  <li><hr class="dropdown-divider"></li>
68:                  <%= button_to "Sair", destroy_user_session_path, method: :delete, class: "dropdown-item" %>
69:                </ul>
70:              </div>
71:            <% else %>
72:              <button class="btn btn-primary rounded-pill " data-bs-toggle="modal" data-bs-target="#loginModal">
73:                Entrar
74:              </button>
75:            <% end %>
