1:    <div class="div d-none d-lg-block">
2:      <%= image_tag "/layout/assets/img/NovoBanner.png", class: "group-2-7-img", style: "width: 100%;" %>
3:    </div>
4:    <!-- HOME SECTION -->
5:    <section id="home" class="hero">
6:      <div class="container">
7:        <div class="row align-items-center">
8:          <div class="col-lg-6 hero-content">
9:            <h1 class="hero-title">
10:              Transforme suas letras em verdadeiras obras de arte
11:            </h1>
12:            <p class="hero-subtitle lead" style="color: #0d111a">
13:              Recursos, cursos e inspiração para artistas de lettering que
14:              desejam elevar sua arte ao próximo nível.
15:            </p>
16:            <div class="d-flex gap-3">
17:              <%= link_to "Ver Papelaria Digital", root_path, class: "btn btn-primary btn-lg rounded-pill" %>
18:              <%= link_to "Explorar Cursos", root_path, class: "btn btn-light btn-lg rounded-pill" %>
19:            </div>
20:          </div>
21:          <div class="col-lg-6 hero-img mt-5 mt-lg-0">
22:            <%= image_tag "https://direitocomevellyn.com/wp-content/uploads/2024/06/prod-1.png", alt: "Lettering Art", class: "img-fluid" %>
23:          </div>
24:        </div>
25:      </div>
26:    </section>
27:    <!-- Produtos SECTION -->
28:    <section class="py-5 bg-light">
29:      <div class="container">
30:        <div class="text-center mb-5">
31:          <h2 class="fw-bold">Destaques da Papelaria Digital</h2>
32:          <p class="text-muted">Confira alguns dos nossos produtos disponíveis</p>
33:        </div>
34:        <div class="mb-4 d-flex flex-wrap justify-content-center gap-2">
35:          <button class="filter-btn active">Todos</button>
36:          <% @g_categorias.each do |categoria| %>
37:            <%= link_to categoria.nome, root_path(categoria: categoria.slug), class: "filter-btn" %>
38:          <% end %>
39:        </div>
40:        <div class="row g-4">
41:          <% @i_produtos.each do |produto| %>
42:            <div class="col-lg-4 col-md-6">
43:              <div class="card h-100 product-card">
44:                <% if# produto.desconto.present? && produto.desconto > 0 %>
45:                  <span class="badge bg-danger product-badge">-<%=# produto.desconto %>%</span>
46:                <% #elsif produto.created_at >= 30.days.ago %>
47:                  <span class="badge bg-success product-badge">Novo</span>
48:                <%# end %>
49:                <div class="product-actions">
50:                  <a href="#" class="product-action-btn">
51:                    <i class="lucide-heart"></i>
52:                  </a>
53:                  <a href="<%= i_produto_path(produto) %>" class="product-action-btn">
54:                    <i class="lucide-eye"></i>
55:                  </a>
56:                </div>
57:                <% if produto.imagem.attached? %>
58:                  <%= image_tag url_for(produto.imagem), class: "card-img-top", alt: produto.nome %>
59:                <% else %>
60:                  <div class="card-img-top d-flex align-items-center justify-content-center bg-light">
61:                    <i class="lucide-image text-muted" style="font-size: 3rem;"></i>
62:                  </div>
63:                <% end %>
64:                <div class="card-body">
65:                  <div class="d-flex justify-content-between align-items-center mb-2">
66:                    <% if produto.g_categoria.present? %>
67:                      <span class="badge bg-primary"><%= produto.g_categoria.nome %></span>
68:                    <% else %>
69:                      <span class="badge bg-secondary">Geral</span>
70:                    <% end %>
71:                    <div class="product-rating">
72:                      <div class="stars">
73:                        <% 5.times do |i| %>
74:                          <% if produto.avaliacao && i < produto.avaliacao.floor %>
75:                            <i class="lucide-star"></i>
76:                          <% elsif produto.avaliacao && i < produto.avaliacao %>
77:                            <i class="lucide-star-half"></i>
78:                          <% else %>
79:                            <i class="lucide-star" style="opacity: 0.3;"></i>
80:                          <% end %>
81:                        <% end %>
82:                      </div>
83:                      <span class="count">(<%= produto.avaliacoes_count || rand(5..50) %>)</span>
84:                    </div>
85:                  </div>
86:                  <h5 class="card-title"><%= produto.nome %></h5>
87:                  <p class="card-text"><%= truncate(produto.descricao, length: 100) %></p>
88:                  <div class="product-price">
89:                    <% if produto.preco_original.present? && produto.preco_original > produto.preco %>
90:                      <span class="original-price">R$ <%= number_to_currency(produto.preco_original, unit: "", separator: ",", delimiter: ".") %></span>
91:                    <% end %>
92:                    <span>R$ <%= number_to_currency(produto.preco, unit: "", separator: ",", delimiter: ".") %></span>
93:                  </div>
94:                  <button class="btn btn-primary rounded-pill w-100">
95:                    Adicionar ao Carrinho
96:                  </button>
97:                </div>
98:              </div>
99:            </div>
100:          <% end %>
101:        </div>
102:        <div class="mt-5">
103:          <%= pagy_bootstrap_nav(@pagy, link_extra: 'class="page-link"').html_safe %>
104:        </div>
105:      </div>
106:    </section>
107:    <style></style>
  
