                <!-- REMOVIDO O LINK TEMPORARIAMENTE -->
                <%= post.titulo %>
              </h2>
              <div class="blog-post-excerpt">
                <p><%= post.resumo %></p>
              </div>
              <!-- REMOVIDO O LINK TEMPORARIAMENTE -->
              <span class="blog-post-link text-muted">
                Em breve <i class="lucide-arrow-right"></i>
              </span>
            </article>
          <% end %>
        <% else %>
