  <script>
    document.addEventListener("DOMContentLoaded", function() {
      // Seleciona todos os botões com a classe 'btn-danger' e id de exclusão
      const deleteButtons = document.querySelectorAll("[id^='delete-btn-']");

      // Itera sobre os botões e adiciona o evento de clique
      deleteButtons.forEach(function(button) {
        button.addEventListener("click", function(event) {
          event.preventDefault(); // Impede o comportamento padrão do botão

          // Obtém a mensagem de confirmação personalizada
          const confirmMessage = button.getAttribute("data-confirm_message");

          // Exibe o alerta de confirmação
          const isConfirmed = confirm(confirmMessage);

          // Se o usuário confirmar, envia o formulário para excluir
          if (isConfirmed) {
            // Submete o formulário manualmente para realizar a exclusão
            const form = document.createElement("form");
            form.method = "POST";
            form.action = button.getAttribute("href"); // Pega o caminho de exclusão

            // Adiciona o token CSRF para evitar erro de segurança
            const csrfToken = document.querySelector("meta[name='csrf-token']").getAttribute("content");
            const csrfInput = document.createElement("input");
            csrfInput.type = "hidden";
            csrfInput.name = "authenticity_token";
            csrfInput.value = csrfToken;
            form.appendChild(csrfInput);

            // Adiciona o método DELETE no formulário (Rails requer isso em formulários)
            const methodInput = document.createElement("input");
            methodInput.type = "hidden";
            methodInput.name = "_method";
            methodInput.value = "delete";
            form.appendChild(methodInput);

            // Adiciona o formulário ao corpo e envia
            document.body.appendChild(form);
            form.submit();
          }
        });
      });
    });
</script>
