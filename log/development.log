      <!-- Sidebar -->
      <div class="col-lg-4">
        <aside class="blog-sidebar">
          <div class="sidebar-widget">
            <h4 class="sidebar-widget-title">Pesquisar</h4>
            <%= form_with url: blog_path, method: :get, local: true do |form| %>
              <div class="input-group">
                <%= form.text_field :busca, 
                    value: params[:busca], 
                    class: "form-control", 
                    placeholder: "Buscar artigos..." %>
                <button class="btn btn-primary" type="submit">
                  <i class="lucide-search"></i>
                </button>
              </div>
            <% end %>
