<% content_for :title, "Meus Pedidos" %>
<div class="container-fluid py-4">
  <div class="row">
    <!-- Header da página -->
    <div class="col-12 mb-4">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h2 class="fw-bold text-dark mb-1">Meus Pedidos</h2>
          <p class="text-muted mb-0">Acompanhe seus pedidos e histórico de compras</p>
        </div>
        <div class="d-flex gap-2">
          <%= link_to root_path, class: "btn btn-outline-primary rounded-pill" do %>
            <i class="lucide-arrow-left me-2"></i>Voltar à Loja
          <% end %>
        </div>
      </div>
    </div>
    <!-- Cards de Estatísticas -->
    <div class="col-12 mb-4">
      <div class="row g-3">
        <div class="col-md-3">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
              <div class="d-flex align-items-center justify-content-center mb-2">
                <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                  <i class="lucide-shopping-bag text-primary" style="width: 24px; height: 24px;"></i>
                </div>
              </div>
              <h4 class="fw-bold text-dark mb-1"><%= @total_pedidos %></h4>
              <p class="text-muted small mb-0">Total de Pedidos</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
              <div class="d-flex align-items-center justify-content-center mb-2">
                <div class="bg-success bg-opacity-10 rounded-circle p-3">
                  <i class="lucide-dollar-sign text-success" style="width: 24px; height: 24px;"></i>
                </div>
              </div>
              <h4 class="fw-bold text-dark mb-1">R$ <%= number_with_precision(@total_gasto, precision: 2, delimiter: '.', separator: ',') %></h4>
              <p class="text-muted small mb-0">Total Investido</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
              <div class="d-flex align-items-center justify-content-center mb-2">
                <div class="bg-info bg-opacity-10 rounded-circle p-3">
                  <i class="lucide-calendar text-info" style="width: 24px; height: 24px;"></i>
                </div>
              </div>
              <h4 class="fw-bold text-dark mb-1">
                <%= @pedido_recente&.created_at&.strftime('%d/%m') || '-' %>
              </h4>
              <p class="text-muted small mb-0">Último Pedido</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
              <div class="d-flex align-items-center justify-content-center mb-2">
                <div class="bg-warning bg-opacity-10 rounded-circle p-3">
                  <i class="lucide-star text-warning" style="width: 24px; height: 24px;"></i>
                </div>
              </div>
              <h4 class="fw-bold text-dark mb-1"><%= @produtos_favoritos.keys.first || '-' %></h4>
              <p class="text-muted small mb-0">Produto Favorito</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Lista de Pedidos -->
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 py-3">
          <h5 class="fw-bold mb-0">Histórico de Pedidos</h5>
        </div>
        <div class="card-body p-0">
          <% if @pedidos.any? %>
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead class="table-light">
                  <tr>
                    <th class="border-0 fw-semibold">Pedido</th>
                    <th class="border-0 fw-semibold">Data</th>
                    <th class="border-0 fw-semibold">Status</th>
                    <th class="border-0 fw-semibold">Itens</th>
                    <th class="border-0 fw-semibold">Total</th>
                    <th class="border-0 fw-semibold text-center">Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% @pedidos.each do |pedido| %>
                    <tr>
                      <td class="align-middle">
                        <div class="d-flex align-items-center">
                          <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                            <i class="lucide-package text-primary" style="width: 16px; height: 16px;"></i>
                          </div>
                          <div>
                            <h6 class="fw-semibold mb-0">#<%= pedido.id %></h6>
                            <small class="text-muted">Pedido <%= pedido.id %></small>
                          </div>
                        </div>
                      </td>
                      <td class="align-middle">
                        <div>
                          <div class="fw-medium"><%= pedido.created_at.strftime('%d/%m/%Y') %></div>
                          <small class="text-muted"><%= pedido.created_at.strftime('%H:%M') %></small>
                        </div>
                      </td>
                      <td class="align-middle">
                        <%
                        status_class =  pedido.status
                        status_text = (pedido.status || 'status desconhecido').humanize
                        %>
                        <span class="badge bg-<%= status_class %> bg-opacity-10 text-<%= status_class %> border border-<%= status_class %> border-opacity-25">
                          <%= status_text %>
                        </span>
                      </td>
                      <td class="align-middle">
                        <div>
                          <div class="fw-medium"><%= pedido.i_itens_pedidos.sum(:quantidade) %> item(s)</div>
                          <small class="text-muted">
                            <%= pedido.i_itens_pedidos.first&.i_produto&.nome %>
                            <% if pedido.i_itens_pedidos.count > 1 %>
                              + <%= pedido.i_itens_pedidos.count - 1 %> mais
                            <% end %>
                          </small>
                        </div>
                      </td>
                      <td class="align-middle">
                        <div class="fw-bold text-dark">
                          R$ <%= number_with_precision(pedido.total, precision: 2, delimiter: '.', separator: ',') %>
                        </div>
                      </td>
                      <td class="align-middle text-center">
                        <%= link_to g_admin_pedido_detalhes_path(pedido), class: "btn btn-sm btn-outline-primary rounded-pill" do %>
                          <i class="lucide-eye me-1" style="width: 14px; height: 14px;"></i>
                          Ver Detalhes
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            <!-- Paginação -->
            <% if @pedidos.respond_to?(:total_pages) && @pedidos.total_pages > 1 %>
              <div class="card-footer bg-white border-0 py-3">
                <div class="d-flex justify-content-center">
                  <%= pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %>
                </div>
              </div>
            <% end %>
          <% else %>
            <!-- Estado vazio -->
            <div class="text-center py-5">
              <div class="mb-4">
                <i class="lucide-shopping-bag text-muted" style="width: 64px; height: 64px;"></i>
              </div>
              <h5 class="fw-bold text-dark mb-2">Nenhum pedido encontrado</h5>
              <p class="text-muted mb-4">Você ainda não fez nenhum pedido. Que tal começar agora?</p>
              <%= link_to root_path, class: "btn btn-primary rounded-pill" do %>
                <i class="lucide-shopping-cart me-2"></i>Começar a Comprar
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- CSS Customizado -->
<style>
  .card {
    transition: all 0.3s ease;
  }

  .card:hover {
    transform: translateY(-2px);
  }

  .table tbody tr {
    transition: all 0.2s ease;
  }

  .table tbody tr:hover {
    background-color: rgba(0, 123, 255, 0.05);
  }

  .badge {
    font-weight: 500;
    padding: 0.5rem 0.75rem;
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
  }

  @media (max-width: 768px) {
    .table-responsive {
      font-size: 0.875rem;
    }

    .card-body {
      padding: 1rem;
    }
  }
</style>