<%= render "shared/context_nav", title: t("activerecord.models.GBlogCategoria.other"), new_path: new_g_blog_categoria_path do %>
  <span class="breadcrumb-item active"><%= t("activerecord.models.GBlogCategoria.other") %></span>
<% end %>
<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h2 class="card-title"><%= t("activerecord.models.GBlogCategoria.other") %></h2>
    <div>
      <%= link_to new_g_blog_categoria_path, class: "btn btn-sm btn-primary" do %>
        <i class="lucide-plus-circle"></i> Incluir
      <% end %>
    </div>
  </div>
  <!-- Filtro com Ransack -->
  <div class="card-body">
    <%= search_form_for @q, url: g_blog_categorias_path, method: :get, html: { class: "mb-3" } do |f| %>
      <div class="row">
        <div class="col-md-4">
          <%= f.label :descricao_cont, t("activerecord.attributes.g_blog_categoria.descricao") %>
          <%= f.search_field :descricao_cont, class: "form-control", placeholder: "Pesquisar por Descrição" %>
        </div>
        <div class="col-md-4 d-flex align-items-end">
          <%= f.submit "Filtrar", class: "btn btn-sm btn-primary me-2" %>
          <%= link_to "Limpar", g_blog_categorias_path, class: "btn btn-sm btn-secondary" if params[:q] %>
        </div>
      </div>
    <% end %>
  </div>
  <!-- Tabela -->
  <div class="card-body">
    <div class="table-responsive" style="height: 400px; overflow-y: auto;">
      <table class="table table-sm table-bordered table-striped">
        <thead>
          <tr>
            <th class="text-center">Ações</th>
            <th><%= sort_link(@q, :descricao, t("activerecord.attributes.g_blog_categoria.descricao")) %></th>
          </tr>
        </thead>
        <tbody>
          <% @g_blog_categorias.each do |g_blog_categoria| %>
            <tr>
              <td class="text-center">
                <div class="dropdown">
                  <a href="#" class="dropdown-toggle text-body" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ph-gear"></i>
                  </a>
                  <div class="dropdown-menu">
                    <div class="dropdown-header">Opções</div>
                    <%= link_to edit_g_blog_categoria_path(g_blog_categoria), class: "dropdown-item" do %>
                      <i class="ph-pen me-2"></i> Editar
                    <% end %>
                    <%= button_to g_blog_categoria_path(g_blog_categoria), method: :delete, data: { confirm: "Tem certeza que deseja excluir?" }, class: "dropdown-item text-danger" do %>
                      <i class="ph-trash-simple me-2"></i> Excluir
                    <% end %>
                  </div>
                </div>
              </td>
              <td><%= g_blog_categoria.descricao %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <!-- Paginação -->
  <div class="card-footer">
    <%= pagy_bootstrap_nav(@pagy, link_extra: 'class="btn btn-outline-secondary btn-sm mx-1"').html_safe %>
  </div>
</div>
<!-- Estilo -->
<style>
  .table-responsive {
    height: 400px;
    overflow-y: auto;
  }
</style>
