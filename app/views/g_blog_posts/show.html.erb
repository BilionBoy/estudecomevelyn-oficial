<div class="container">
  <%= render "shared/notice" %>
  <div class="card border-0 shadow shadow-sm">
    <div class="card-header border-0 d-flex justify-content-between">
      <span class="fs-4">Visualizar G Blog Post</span>
    </div>
    <div class="card-body">
      <div id="<%= dom_id @g_blog_post %>">
          <p>
            <strong>Titulo:</strong>
            <%= @g_blog_post.titulo %>
          </p>
          <p>
            <strong>Resumo:</strong>
            <%= @g_blog_post.resumo %>
          </p>
          <p>
            <strong>Conteudo:</strong>
            <%= @g_blog_post.conteudo %>
          </p>
          <p>
            <strong>Data Publicacao:</strong>
            <%= @g_blog_post.data_publicacao %>
          </p>
          <p>
            <strong>G Blog Categoria:</strong>
            <%= @g_blog_post.g_blog_categoria %>
          </p>
      </div>
    </div>
    <div class="card-footer border-0 d-flex justify-content-between">
      <div>
        <%= link_to edit_g_blog_post_path(@g_blog_post), class: "btn btn-primary" do %>
        <i class="bi bi-pencil-square"></i> Editar
        <% end %>
        <%= link_to "Voltar", g_blog_posts_path, class: "btn btn-secondary" %>
      </div>
      <%= button_to "Deletar", @g_blog_post, method: :delete, class: "btn btn-outline-danger border-0" %>
    </div>
  </div>
</div>
