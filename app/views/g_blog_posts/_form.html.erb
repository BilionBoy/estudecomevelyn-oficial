<%= render "shared/context_nav", title: t("activerecord.models.#{GBlogPost.model_name.i18n_key}.other") do  %>
  <span class="breadcrumb-item"><%= link_to t("activerecord.models.#{GBlogPost.model_name.i18n_key}.other"), g_blog_posts_path, class: "text-dark" %></span>
  <span class="breadcrumb-item active"><%= t("helpers.submit.#{params[:action]}") %></span>
<% end %>
<%= simple_form_for(@g_blog_post) do |f| %>
  <div class="card">
    <div class="card-header">
      <h5 class="my-0">
        <%= @g_blog_post.new_record? ? "Incluir " : "Editar " %><%= t("activerecord.models.#{GBlogPost.model_name.i18n_key}.one") %>
      </h5>
    </div>
    <div class="card-body">
      <%= f.error_notification %>
      <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>
      <div class="row">
        <div class="col-12">
          <%= f.input :titulo, input_html: { class: "capitalize"}, placeholder: "Titulo"  %>
        </div>
        <div class="col-12">
          <%= f.input :resumo, input_html: { class: "capitalize"}, placeholder: "Resumo"  %>
        </div>
        <div class="col-12">
          <%= f.input :conteudo, input_html: { class: "capitalize"}, placeholder: "Conteudo"  %>
        </div>
        <div class="col-12">
          <%= f.input :data_publicacao, input_html: { class: "capitalize"}, placeholder: "Data publicacao"  %>
        </div>
        <div class="form-group col-7">
          <%= f.label :imagem_blog, "Imagem de Capa" %>
          <% if f.object.persisted? && f.object.imagem_blog.attached? %>
            <p>Imagem atual:</p>
            <%= image_tag url_for(f.object.imagem_blog), alt: "Imagem de Capa", size: "100x100", class: "img-thumbnail mb-2" %>
            <div class="form-check mb-2">
              <%= f.check_box :remove_imagem_blog, { class: 'form-check-input' }, '1', '0' %>
              <%= f.label :remove_imagem_blog, "Remover imagem atual", class: 'form-check-label' %>
            </div>
          <% end %>
          <%= f.file_field :imagem_blog, class: "form-control" %>
        </div>
        <div class="col-12">
          <%= f.association :g_blog_categoria, collection: GBlogCategoria.all, label_method: :descricao, value_method: :id, input_html: { class: "form-select" }, prompt: "Selecione a Categoria" %>
        </div>
      </div>
    </div>
    <div class="card-footer">
      <%= btn_submit(f) %>
      <%= link_to "Voltar", g_blog_posts_path, class: "btn btn-light" %>
    </div>
  </div>
<% end %>