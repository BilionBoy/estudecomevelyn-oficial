<div id="<%= dom_id g_blog_post %>">
  <p>
    <strong>Titulo:</strong>
    <%= g_blog_post.titulo %>
  </p>

  <p>
    <strong>Resumo:</strong>
    <%= g_blog_post.resumo %>
  </p>

  <p>
    <strong>Conteudo:</strong>
    <%= g_blog_post.conteudo %>
  </p>

  <p>
    <strong>Data publicacao:</strong>
    <%= g_blog_post.data_publicacao %>
  </p>

  <p>
    <strong>G blog categoria:</strong>
    <%= g_blog_post.g_blog_categoria_id %>
  </p>

</div>
