<%= render "shared/context_nav", title: t("activerecord.models.#{GCategoria.model_name.i18n_key}.other") do  %>
  <span class="breadcrumb-item"><%= link_to t("activerecord.models.#{GCategoria.model_name.i18n_key}.other"), g_categorias_path, class: "text-dark" %></span>
  <span class="breadcrumb-item active"><%= t("helpers.submit.#{params[:action]}") %></span>
<% end %>
<%= simple_form_for(@g_categoria) do |f| %>
  <div class="card">
    <div class="card-header">
      <h5 class="my-0">
        <%= @g_categoria.new_record? ? "Incluir " : "Editar " %><%= t("activerecord.models.#{GCategoria.model_name.i18n_key}.one") %>
      </h5>
    </div>
    <div class="card-body">
      <%= f.error_notification %>
      <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>
      <div class="row">
        <div class="col-12">
          <%= f.input :nome, input_html: { class: "capitalize"}, placeholder: "Nome"  %>
        </div>
        <div class="col-12">
          <%= f.input :slug, input_html: { class: "capitalize"}, placeholder: "Slug"  %>
        </div>
        <div class="col-12">
          <%= f.input :descricao, input_html: { class: "capitalize"}, placeholder: "Descricao"  %>
        </div>
        <div class="col-12">
          <%= f.association :segmento,  collection: Segmento.all,  label_method: :nome,  value_method: :id,  input_html: { class: "capitalize" },  placeholder: "Segmento" %>
        </div>
        <div class="form-group">
          <%= f.label :foto_categoria, "Imagem de Capa" %>
          <%= f.file_field :foto_categoria, class: "form-control" %>
          <% if f.object.foto_categoria.attached? %>
            <p class="mt-2">Imagem atual:</p>
            <%= image_tag url_for(f.object.foto_categoria), alt: "Imagem de Capa", size: "100x100", class: "img-thumbnail mb-2" %>
          <% else %>
            <p class="mt-2">Não há imagem cadastrada.</p>
          <% end %>
          <% if f.object.foto_categoria.attached? %>
            <div class="form-check mb-2">
              <%= f.check_box :remove_foto_categoria, { class: 'form-check-input' }, '1', '0' %>
              <%= f.label :remove_foto_categoria, "Remover imagem atual", class: 'form-check-label' %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <div class="card-footer">
      <%= btn_submit(f) %>
      <%= link_to "Voltar", g_categorias_path, class: "btn btn-light" %>
    </div>
  </div>
<% end %>