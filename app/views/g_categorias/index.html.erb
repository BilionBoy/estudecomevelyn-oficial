<%= render "shared/context_nav", title: t("activerecord.models.#{GCategoria.model_name.i18n_key}.other"), new_path: new_g_categoria_path do %>
  <span class="breadcrumb-item active"><%= t("activerecord.models.#{GCategoria.model_name.i18n_key}.other") %></span>
<% end %>
<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <!-- Barra de Pesquisa -->
    <%= search_form_for @q, html: { class: "d-flex gap-2", autocomplete: "off" } do |f| %>
      <%= f.search_field :nome_cont, class: "form-control", placeholder: "Pesquisar" %>
      <%= f.button(type: 'submit', class: 'btn btn-info') { tag.i(class: 'ph-magnifying-glass') } %>
      <%= link_to tag.i(class: 'ph-x-circle'), g_categorias_path, class: "btn btn-light" if params[:q] %>
    <% end %>
    <!-- Botão para adicionar nova categoria -->
    <%= link_to t('Incluir'), new_g_categoria_path, class: 'btn btn-primary ms-2' %>
  </div>
  <div class="card-body">
    <!-- Tabela de Categorias -->
    <div class="table-responsive">
      <table class="table table-sm table-bordered table-striped">
        <thead>
          <tr>
            <th class="text-center">Ações</th>
            <th><%= sort_link(@q, :nome, t("activerecord.attributes.g_categoria.nome")) %></th>
            <th><%= sort_link(@q, :slug, t("activerecord.attributes.g_categoria.slug")) %></th>
            <th><%= sort_link(@q, :descricao, t("activerecord.attributes.g_categoria.descricao")) %></th>
            <th><%= sort_link(@q, :segmento, t("activerecord.attributes.g_categoria.segmento")) %></th>
            <th><%= sort_link(@q, :created_at, t("activerecord.attributes.g_categoria.created_at")) %></th>
            <th><%= sort_link(@q, :updated_at, t("activerecord.attributes.g_categoria.updated_at")) %></th>
          </tr>
        </thead>
        <tbody>
          <% @g_categorias.each do |g_categoria| %>
            <tr>
              <td class="text-center">
                <!-- Menu de Ações -->
                <div class="dropdown">
                  <a href="#" class="text-body dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ph-gear"></i>
                  </a>
                  <div class="dropdown-menu">
                    <div class="dropdown-header">Opções</div>
                    <%= link_to edit_g_categoria_path(g_categoria), class: "dropdown-item" do %>
                      <i class="ph-pen me-2"></i> Editar
                    <% end %>
                    <%= form_for g_categoria, method: :delete, data: { confirm: 'Tem certeza que deseja excluir?' } do |f| %>
                      <%= link_to '#', class: "dropdown-item", data: { confirm: 'Excluir?' }, onclick: "this.closest('form').submit();" do %>
                        <i class="ph-trash-simple me-2"></i>Excluir
                      <% end %>
                    <% end %>
                  </div>
                </div>
              </td>
              <td><%= g_categoria.nome %></td>
              <td><%= g_categoria.slug %></td>
              <td><%= g_categoria.descricao %></td>
              <td><%= g_categoria.segmento&.nome || '-' %></td>
              <td><%= g_categoria.created_at.strftime('%d/%m/%Y') %></td>
              <td><%= g_categoria.updated_at.strftime('%d/%m/%Y') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <!-- Paginação -->
  <div class="card-footer">
    <%= pagy_bootstrap_nav(@pagy, link_extra: 'class="btn btn-outline-secondary btn-sm mx-1"').html_safe %>
  </div>
</div>
