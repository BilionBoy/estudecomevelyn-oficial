<div class="container">
  <%= render "shared/notice" %>
  <div class="card border-0 shadow shadow-sm">
    <div class="card-header border-0 d-flex justify-content-between">
      <span class="fs-4">Visualizar G Categoria</span>
    </div>
    <div class="card-body">
      <div id="<%= dom_id @g_categoria %>">
          <p>
            <strong>Nome:</strong>
            <%= @g_categoria.nome %>
          </p>
          <p>
            <strong>Slug:</strong>
            <%= @g_categoria.slug %>
          </p>
          <p>
            <strong>Descricao:</strong>
            <%= @g_categoria.descricao %>
          </p>
          <p>
            <strong>Segmento:</strong>
            <%= @g_categoria.segmento %>
          </p>
          <p>
            <strong>Created At:</strong>
            <%= @g_categoria.created_at %>
          </p>
          <p>
            <strong>Updated At:</strong>
            <%= @g_categoria.updated_at %>
          </p>
          <p>
            <strong>Deleted At:</strong>
            <%= @g_categoria.deleted_at %>
          </p>
      </div>
    </div>
    <div class="card-footer border-0 d-flex justify-content-between">
      <div>
        <%= link_to edit_g_categoria_path(@g_categoria), class: "btn btn-primary" do %>
        <i class="bi bi-pencil-square"></i> Editar
        <% end %>
        <%= link_to "Voltar", g_categorias_path, class: "btn btn-secondary" %>
      </div>
      <%= button_to "Deletar", @g_categoria, method: :delete, class: "btn btn-outline-danger border-0" %>
    </div>
  </div>
</div>
