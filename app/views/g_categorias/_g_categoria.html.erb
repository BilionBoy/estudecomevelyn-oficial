<div id="<%= dom_id g_categoria %>">
  <p>
    <strong>Nome:</strong>
    <%= g_categoria.nome %>
  </p>

  <p>
    <strong>Slug:</strong>
    <%= g_categoria.slug %>
  </p>

  <p>
    <strong>Descricao:</strong>
    <%= g_categoria.descricao %>
  </p>

  <p>
    <strong>Segmento:</strong>
    <%= g_categoria.segmento_id %>
  </p>

  <p>
    <strong>Created at:</strong>
    <%= g_categoria.created_at %>
  </p>

  <p>
    <strong>Updated at:</strong>
    <%= g_categoria.updated_at %>
  </p>

  <p>
    <strong>Deleted at:</strong>
    <%= g_categoria.deleted_at %>
  </p>

</div>
