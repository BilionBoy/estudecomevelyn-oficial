<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h2 class="card-title"><%= t("activerecord.models.#{Segmento.model_name.i18n_key}.other") %></h2>
    <div>
      <%= link_to new_segmento_path, class: "btn btn-sm btn-primary" do %>
        <i class="lucide-plus-circle"></i> Incluir Novo Segmento
      <% end %>
    </div>
  </div>
  <!-- Filtro Ransack -->
  <div class="card-body">
    <%= search_form_for @q, url: segmentos_path, method: :get, html: { class: "mb-3" } do |f| %>
      <div class="row">
        <div class="col-md-4">
          <%= f.label :nome_cont, "Nome" %>
          <%= f.search_field :nome_cont, class: "form-control", placeholder: "Pesquisar por nome" %>
        </div>
        <div class="col-md-4">
          <%= f.label :descricao_cont, "Descrição" %>
          <%= f.search_field :descricao_cont, class: "form-control", placeholder: "Pesquisar por descrição" %>
        </div>
        <div class="col-md-4 d-flex align-items-end">
          <%= f.submit "Filtrar", class: "btn btn-sm btn-primary" %>
        </div>
      </div>
    <% end %>
  </div>
  <!-- Tabela de Segmentos -->
  <div class="card-body">
    <div class="table-responsive" style="height: 400px; overflow-y: auto;">
      <table class="table table-sm table-bordered table-striped">
        <thead>
          <tr>
            <th class="text-center">Ações</th>
            <th><%= sort_link(@q, :nome, t("activerecord.attributes.segmento.nome")) %></th>
            <th><%= sort_link(@q, :descricao, t("activerecord.attributes.segmento.descricao")) %></th>
          </tr>
        </thead>
        <tbody>
          <% @segmentos.each do |segmento| %>
            <tr>
              <td class="text-center">
                <div class="dropdown">
                  <a href="#" class="dropdown-toggle text-body" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ph-gear"></i>
                  </a>
                  <div class="dropdown-menu">
                    <div class="dropdown-header">Opções</div>
                    <%= link_to edit_segmento_path(segmento), class: "dropdown-item" do %>
                      <i class="ph-pen me-2"></i> Editar
                    <% end %>
                    <%= form_for segmento, method: :delete do |f| %>
                      <a class="dropdown-item" data-confirm-delete="<%= segmento_path(segmento) %>" data-csrf-token="<%= form_authenticity_token %>">
                        <i class="ph-trash-simple me-2"></i> Excluir
                      </a>
                    <% end %>
                  </div>
                </div>
              </td>
              <td><%= segmento.nome %></td>
              <td><%= segmento.descricao %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <!-- Paginação -->
  <div class="card-footer">
    <%= pagy_bootstrap_nav(@pagy, link_extra: 'class="btn btn-outline-secondary btn-sm mx-1"').html_safe %>
  </div>
</div>
<!-- Estilo -->
<style>
  .table-responsive {
    height: 400px;
    overflow-y: auto;
  }
</style>
