<%= render "shared/context_nav", title: t("activerecord.models.#{IProduto.model_name.i18n_key}.other") do  %>
  <span class="breadcrumb-item"><%= link_to t("activerecord.models.#{IProduto.model_name.i18n_key}.other"), i_produtos_path, class: "text-dark" %></span>
  <span class="breadcrumb-item active"><%= t("helpers.submit.#{params[:action]}") %></span>
<% end %>
<%= simple_form_for(@i_produto, html: { multipart: true }) do |f| %>
  <div class="card">
    <div class="card-header">
      <h5 class="my-0">
        <%= @i_produto.new_record? ? "Incluir " : "Editar " %><%= t("activerecord.models.#{IProduto.model_name.i18n_key}.one") %>
      </h5>
    </div>
    <div class="card-body">
      <%= f.error_notification %>
      <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>
      <div class="row">
        <div class="col-md-7">
          <%= f.input :nome, input_html: { class: "capitalize"}, placeholder: "Nome"  %>
        </div>
        <div class="col-md-5">
          <%= f.input :preco, input_html: { class: "capitalize"}, placeholder: "Preco"  %>
        </div>
        <div class="col-12">
          <%= f.input :descricao, input_html: { class: "capitalize"}, placeholder: "Descricao"  %>
        </div>
        <div class="col-5">
          <%= f.input :g_categoria_id, collection: GCategoria.all.map { |c| [c.nome, c.id] }, prompt: "Selecione a categoria", input_html: { class: "capitalize" } %>
        </div>
        <div class="col-7">
          <%= f.input :arquivo, as: :file, label: "Arquivo do Produto" %>
        </div>
        <div class="col-5">
          <%= f.input :status, collection: IProduto.statuses.map { |k, _| [k.titleize, k] }, prompt: "Selecione o status" %>
        </div>
        <div class="form-group col-7">
          <%= f.label :imagem, "Imagem de Capa" %>
          <% if f.object.persisted? && f.object.imagem.attached? %>
            <p>Imagem atual:</p>
            <%= image_tag url_for(f.object.imagem), alt: "Imagem de Capa", size: "100x100", class: "img-thumbnail mb-2" %>
            <div class="form-check mb-2">
              <%= f.check_box :remove_imagem, { class: 'form-check-input' }, '1', '0' %>
              <%= f.label :remove_imagem, "Remover imagem atual", class: 'form-check-label' %>
            </div>
          <% end %>
          <%= f.file_field :imagem, class: "form-control" %>
        </div>
        <div class="col-7">
          <% if f.object.imagem.attached? %>
            <%= image_tag url_for(f.object.imagem), alt: "Imagem de Capa", class: "img-thumbnail mb-2" %>
          <% else %>
            <p>Não há imagem cadastrada.</p>
          <% end %>
        </div>
      </div>
    </div>
    <div class="card-footer">
      <%= btn_submit(f) %>
      <%= link_to "Voltar", i_produtos_path, class: "btn btn-light" %>
    </div>
  </div>
<% end %>