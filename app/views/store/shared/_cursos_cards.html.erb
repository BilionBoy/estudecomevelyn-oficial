<div class="row" id="cursos-container">
  <% cursos.each do |curso| %>
    <div class="col-lg-4 col-md-6 mb-4 curso-item" data-categoria="<%= curso.g_categoria.slug %>">
      <div class="card border-0 shadow-sm h-100 curso-card" style="border-radius: 20px; overflow: hidden; transition: all 0.3s ease;">
        <!-- Imagem do Curso -->
        <div class="position-relative" style="height: 250px;">
          <% if curso.imagem_capa.attached? %>
            <%= image_tag curso.imagem_capa.variant(resize_to_fill: [400, 250]), 
                class: "card-img-top w-100 h-100", 
                style: "object-fit: cover; opacity: 0.9;", 
                alt: curso.nome %>
          <% else %>
            <div class="w-100 h-100 d-flex align-items-center justify-content-center text-white">
              <i class="fas fa-graduation-cap fa-3x opacity-50"></i>
            </div>
          <% end %>
          <!-- Badge da Categoria -->
          <span class="badge position-absolute top-0 start-0 m-3 px-3 py-2 fw-bold text-uppercase" 
                style="background: <%= curso.g_categoria.nome.downcase == 'treinos' ? '#ec4899' : '#f97316' %>; border-radius: 20px;">
            <%= curso.g_categoria.nome %>
          </span>
        </div>
        <!-- Conteúdo do Card -->
        <div class="card-body p-4 d-flex flex-column">
          <h5 class="card-title fw-bold mb-3" style="color: #1a1a1a; line-height: 1.3;">
            <%= curso.nome %>
          </h5>
          <p class="card-text text-muted mb-4 flex-grow-1" style="font-size: 14px; line-height: 1.6;">
            <%= truncate(curso.descricao, length: 120) %>
          </p>
          <!-- Preço e Botão -->
          <div class="mt-auto">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div>
                <h4 class="fw-bold text-primary mb-0"><%= number_to_currency(curso.preco) %></h4>
                <small class="text-muted">ou 12x sem juros</small>
              </div>
            </div>
            <button class="btn btn-primary w-100 py-3 fw-bold saiba-mais-btn" 
                    data-curso-id="<%= curso.id %>"
                    data-curso-nome="<%= curso.nome %>"
                    data-curso-descricao="<%= curso.descricao %>"
                    data-curso-preco="<%= number_to_currency(curso.preco) %>"
                    data-curso-categoria="<%= curso.g_categoria.nome %>"
                    data-curso-url="<%= curso.url_externa %>"
                    data-curso-imagem="<%= curso.imagem_capa.attached? ? url_for(curso.imagem_capa.variant(resize_to_fill: [800, 400])) : '' %>"
                    data-bs-toggle="modal" 
                    data-bs-target="#cursoModal">
              Saiba Mais
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
<style>
  .curso-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.1) !important;
  }

  .saiba-mais-btn:hover {
    transform: scale(1.02);
    transition: all 0.2s ease;
  }

  @media (max-width: 768px) {
    .curso-card {
      margin-bottom: 2rem;
    }
  }
</style>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Manipular clique nos botões "Saiba Mais"
    document.querySelectorAll('.saiba-mais-btn').forEach(button => {
      button.addEventListener('click', function() {
        // Pegar dados do curso
        const cursoNome = this.dataset.cursoNome;
        const cursoDescricao = this.dataset.cursoDescricao;
        const cursoPreco = this.dataset.cursoPreco;
        const cursoCategoria = this.dataset.cursoCategoria;
        const cursoUrl = this.dataset.cursoUrl;
        const cursoImagem = this.dataset.cursoImagem;

        // Preencher modal
        document.getElementById('modal-curso-titulo').textContent = cursoNome;
        document.getElementById('modal-curso-descricao').textContent = cursoDescricao;
        document.getElementById('modal-curso-preco').textContent = cursoPreco;
        document.getElementById('modal-curso-categoria').textContent = cursoCategoria;
        document.getElementById('modal-btn-comprar').href = cursoUrl;

        if (cursoImagem) {
          document.getElementById('modal-curso-imagem').src = cursoImagem;
        }

        // Esconder preço original já que não existe no schema
        document.getElementById('modal-curso-preco-original').style.display = 'none';
      });
    });
  });
</script>
