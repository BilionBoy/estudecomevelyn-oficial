<div class="row g-4">
  <% produtos.each do |produto| %>
    <div class="col-lg-4 col-md-6 mb-4 product-item" data-categoria="<%= produto.g_categoria&.slug %>">
      <div class="card h-100 product-card">
        <% if produto.created_at && produto.created_at >= 30.days.ago %>
          <span class="badge bg-success product-badge">NOVO</span>
        <% elsif rand(10) > 7 %> <!-- Simulando alguns produtos com desconto -->
          <span class="badge bg-danger product-badge">-<%= rand(10..30) %>%</span>
        <% end %>
        <!-- Botões de ação -->
        <div class="product-actions">
          <a href="#" class="product-action-btn">
            <i class="lucide-heart"></i>
          </a>
          <a href="<%= i_produto_path(produto) %>" class="product-action-btn">
            <i class="lucide-eye"></i>
          </a>
        </div>
        <!-- Imagem do produto -->
        <% if produto.imagem.attached? %>
          <%= image_tag url_for(produto.imagem), class: "card-img-top", alt: produto.nome %>
        <% else %>
          <div class="card-img-top d-flex align-items-center justify-content-center bg-light">
            <i class="lucide-image text-muted" style="font-size: 3rem;"></i>
          </div>
        <% end %>
        <div class="card-body">
          <!-- Categoria e avaliação -->
          <div class="d-flex justify-content-between align-items-center mb-2">
            <% if produto.g_categoria.present? %>
              <span class="badge bg-primary"><%= produto.g_categoria.nome %></span>
            <% else %>
              <span class="badge bg-primary">Geral</span>
            <% end %>
          </div>
          <!-- Título e descrição -->
          <h5 class="card-title"><%= produto.nome %></h5>
          <p class="card-text"><%= truncate(produto.descricao, length: 100) %></p>
          <!-- Preço (com desconto simulado para alguns produtos) -->
          <div class="product-price">
            <% if rand(10) > 7 %> <!-- Simulando alguns produtos com preço original -->
              <% preco_original = produto.preco * (1 + rand(0.1..0.3)) %>
              <span class="original-price">R$ <%= number_to_currency(preco_original, unit: "", separator: ",", delimiter: ".") %></span>
            <% end %>
            <span>R$ <%= number_to_currency(produto.preco, unit: "", separator: ",", delimiter: ".") %></span>
          </div>
          <!-- Botão de adicionar ao carrinho -->
          <button class="btn btn-primary rounded-pill w-100" data-produto-id="<%= produto.id %>" onclick="adicionarAoCarrinho(this)">
            Adicionar ao Carrinho
          </button>
        </div>
      </div>
    </div>
  <% end %>
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
  /* --- Filtro de produtos --- */

  const filterButtons = document.querySelectorAll('.filter-btn');
  const productCards  = document.querySelectorAll('.product-item[data-categoria]');

  /* --- Cria (ou reaproveita) o placeholder "nenhum produto" --- */
  let noProducts = document.getElementById('no-products');
  if (!noProducts) {
    noProducts = document.createElement('div');
    noProducts.id        = 'no-products';
    noProducts.textContent = 'Nenhum produto nessa categoria';
    noProducts.className = 'd-flex justify-content-center align-items-center text-muted';
    noProducts.style.minHeight = '200px';
    noProducts.style.display   = 'none';
    document.querySelector('.row.g-4')?.appendChild(noProducts);
  }

  /* --- Função que executa o filtro propriamente dito --- */
  function aplicarFiltro(categoria) {
    let algumVisivel = false;

    productCards.forEach(card => {
      const categoriaCard = card.dataset.categoria;
      const mostrar       = categoria === 'todos' || categoria === categoriaCard;

      card.style.display  = mostrar ? 'block' : 'none';
      if (mostrar) algumVisivel = true;
    });

    /* Mostra a mensagem se nada ficou visível */
    noProducts.style.display = algumVisivel ? 'none' : 'flex';
  }

  /* --- Listeners dos botões de filtro --- */
  filterButtons.forEach(btn => {
    btn.addEventListener('click', e => {
      e.preventDefault();   // Impede o salto do link “#”

      /* Alterna a classe .active */
      filterButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      /* Aplica o filtro escolhido */
      aplicarFiltro(btn.dataset.categoria);
    });
  });

  /* --- Clique nos cards de imagem de categoria --- */
  const categoriaCards = document.querySelectorAll('.filter-card[data-categoria]');
  categoriaCards.forEach(card => {
  card.addEventListener('click', () => {
    const slug = card.dataset.categoria;

    // Remove .active dos botões e adiciona no botão correspondente
    filterButtons.forEach(btn => btn.classList.remove('active'));
    filterButtons.forEach(btn => {
      if (btn.dataset.categoria === slug) {
        btn.classList.add('active');
      }
    });

    // Aplica o filtro normalmente
    aplicarFiltro(slug);
  });
  });


  /* --- Filtro inicial ao carregar a página --- */
  const activeBtn = document.querySelector('.filter-btn.active');
  aplicarFiltro(activeBtn ? activeBtn.dataset.categoria : 'todos');

  /* --- Adicionar ao carrinho --- */
   async function adicionarAoCarrinho(botao) {
  const produtoId = botao.dataset.produtoId;

  try {
    const resposta = await fetch("<%= adicionar_ao_carrinho_store_carrinho_path %>", {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector("meta[name='csrf-token']").content
      },
      body: JSON.stringify({ produto_id: produtoId })
    });

    const resultado = await resposta.json();

    if (resultado.success) {
      // Atualiza o contador na navbar
      const badge = document.querySelector('#carrinho-contador');
      if (badge) {
        badge.textContent = resultado.total_itens;
      }

      // Armazenar produto no localStorage
      let produtosNoCarrinho = JSON.parse(localStorage.getItem('produtosCarrinho')) || [];
      if (!produtosNoCarrinho.includes(produtoId)) {
        produtosNoCarrinho.push(produtoId);
        localStorage.setItem('produtosCarrinho', JSON.stringify(produtosNoCarrinho));
      }

      // Feedback visual
      botao.classList.remove('btn-primary');
      botao.classList.add('btn-success');
      botao.textContent = 'Adicionado!';
      botao.disabled = true;
    } else {
      alert('Erro ao adicionar: ' + resultado.message);
    }

  } catch (erro) {
    console.error('Erro ao adicionar ao carrinho:', erro);
    alert('Você precisa se registrar para adicionar ao carrinho.');
  }
  }

  // Substitui o evento do botão de adicionar ao carrinho
  const botaoAdicionar = document.querySelectorAll('.product-item button');
  botaoAdicionar.forEach(btn => {
    btn.addEventListener('click', (e) => {
      adicionarAoCarrinho(e.target);
    });
  });
  });
</script>