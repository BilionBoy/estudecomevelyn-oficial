<header class="fixed-top">
  <nav class="navbar navbar-expand-lg">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center d-none d-lg-block" href="#home">
        <%= image_tag('/layout/assets/img/NewLogo.png', alt: 'Logo', class: 'me-2') %>
      </a>
      <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav"
          >
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav mx-auto">
          <li class="nav-item">
            <a class="nav-link active" href="<%= root_path %>">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link active" href="<%= papelaria_path %>">Eve Notes</a>
          </li>
          <li class="nav-item">
            <a class="nav-link active" href="<%= cursos_path %>">Cursos</a>
          </li>
          <li class="nav-item">
            <a class="nav-link active" href="<%= root_path %>">Blog</a>
          </li>
        </ul>
        <div class="d-flex align-items-center gap-3">
          <button
                class="btn btn-link position-relative"
                data-bs-toggle="modal"
                data-bs-target="#searchModal"
              >
            <i class="lucide-search"></i>
          </button>
          <% if user_signed_in? %>
            <% carrinho = current_user.i_carrinhos.find_by(status: 'ativo') %>
            <% total_itens = carrinho&.i_itens_carrinhos&.sum(:quantidade) || 0 %>
          <% else %>
            <% total_itens = 0 %>
          <% end %>
          <%= link_to store_carrinho_path, class: "btn btn-link position-relative" do %>
            <!-- Ícone de carrinho mais bonito -->
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-shopping-cart">
              <circle cx="8" cy="21" r="1"></circle>
              <circle cx="19" cy="21" r="1"></circle>
              <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
            </svg>
            <span id="carrinho-contador" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary">
              <%= total_itens %>
            </span>
          <% end %>
          <% if user_signed_in? %>
            <div class="dropdown">
              <button class="btn btn-primary rounded-pill d-none d-lg-block dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <%= current_user.email.split('@').first %>
              </button>
              <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                <li><%= link_to "Minha Conta", g_admin_path, class: "dropdown-item" %></li>
                <li><%= link_to "Meus Pedidos", g_admin_path, class: "dropdown-item" %></li>
                <li><hr class="dropdown-divider"></li>
                <%= button_to "Sair", destroy_user_session_path, method: :delete, class: "dropdown-item" %>
              </ul>
            </div>
          <% else %>
            <button class="btn btn-primary rounded-pill " data-bs-toggle="modal" data-bs-target="#loginModal">
              Entrar
            </button>
          <% end %>
        </div>
      </div>
    </div>
  </nav>
</header>
<!-- Modal de Login -->
<div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header border-0">
        <h5 class="modal-title" id="loginModalLabel">Entrar na sua conta</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="text-center mb-4">
          <%= image_tag('/layout/assets/img/LogoEstudeComEvelyn.png', alt: 'Logo', style: 'max-width: 150px;') %>
          <p class="mt-3 text-muted">Acesse sua conta para continuar</p>
        </div>
        <div id="login-error-message" class="alert alert-danger d-none"></div>
        <%= form_with(url: user_session_path, method: :post, id: "login-form", class: "login-form") do |f| %>
          <div class="mb-3">
            <%= f.label :email, "Email", class: "form-label" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "seu@email.com", name: "user[email]" %>
          </div>
          <div class="mb-3">
            <%= f.label :password, "Senha", class: "form-label" %>
            <%= f.password_field :password, autocomplete: "current-password", class: "form-control", placeholder: "Sua senha", name: "user[password]" %>
          </div>
          <div class="mb-3 form-check">
            <%= f.check_box :remember_me, class: "form-check-input", name: "user[remember_me]", id: "user_remember_me" %>
            <%= f.label :remember_me, "Lembrar de mim", class: "form-check-label", for: "user_remember_me" %>
          </div>
          <div class="d-grid gap-2 mb-3">
            <%= f.submit "Entrar", class: "btn btn-primary rounded-pill", id: "login-button" %>
          </div>
        <% end %>
        <div class="text-center mt-3">
          <p><%= link_to "Esqueceu sua senha?", new_user_password_path, class: "text-decoration-none" %></p>
          <p>Não tem uma conta? <%= link_to "Cadastre-se", new_user_registration_path, class: "text-decoration-none fw-bold" %></p>
        </div>
        <% if defined?(User) && User.respond_to?(:omniauth_providers) && User.omniauth_providers.any? %>
          <div class="social-login mt-4">
            <p class="text-center text-muted mb-3">Ou entre com</p>
            <div class="d-flex justify-content-center gap-3">
              <% if User.omniauth_providers.include?(:google_oauth2) %>
                <%= link_to user_google_oauth2_omniauth_authorize_path, class: "btn btn-outline-secondary rounded-pill", method: :post do %>
                  <i class="lucide-google"></i> Google
                <% end %>
              <% end %>
              <% if User.omniauth_providers.include?(:facebook) %>
                <%= link_to user_facebook_omniauth_authorize_path, class: "btn btn-outline-secondary rounded-pill", method: :post do %>
                  <i class="lucide-facebook"></i> Facebook
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
<script>
  // Ativar link de navegação com base na seção visível
  document.addEventListener("DOMContentLoaded", function () {
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll(".navbar-nav .nav-link");

    function highlightNavLink() {
      const scrollY = window.pageYOffset;

      sections.forEach((section) => {
        const sectionHeight = section.offsetHeight;
        const sectionTop = section.offsetTop - 100;
        const sectionId = section.getAttribute("id");

        if (scrollY > sectionTop && scrollY <= sectionTop + sectionHeight) {
          navLinks.forEach((link) => {
            link.classList.remove("active");
            if (link.getAttribute("href") === "#" + sectionId) {
              link.classList.add("active");
            }
          });
        }
      });
    }

    window.addEventListener("scroll", highlightNavLink);

    // Smooth scroll para links internos
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener("click", function (e) {
        e.preventDefault();

        const targetId = this.getAttribute("href");
        const targetElement = document.querySelector(targetId);

        if (targetElement) {
          window.scrollTo({
            top: targetElement.offsetTop - 80,
            behavior: "smooth",
          });
        }
      });
    });

    // Configurar o formulário de login para usar AJAX
    const loginForm = document.getElementById('login-form');
    if (loginForm) {
      loginForm.addEventListener('submit', function(e) {
        e.preventDefault();

        const loginButton = document.getElementById('login-button');
        const errorMessage = document.getElementById('login-error-message');

        // Desabilitar o botão e mostrar loading
        loginButton.disabled = true;
        loginButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Entrando...';

        // Limpar mensagens de erro anteriores
        errorMessage.classList.add('d-none');
        errorMessage.textContent = '';

        // Obter o token CSRF
        const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

        // Enviar o formulário via AJAX
        fetch(loginForm.action, {
          method: 'POST',
          body: new FormData(loginForm),
          headers: {
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
            'X-CSRF-Token': csrfToken
          },
          credentials: 'same-origin'
        })
        .then(response => {
          if (response.ok) {
            return response.json().then(data => {
              if (data.success) {
                // Login bem-sucedido, redirecionar para o painel
                window.location.href = '<%= root_path %>';
              } else {
                throw new Error('Falha na autenticação');
              }
            });
          } else if (response.status === 401) {
            // Credenciais inválidas
            return response.json().then(data => {
              throw new Error(data.error || 'Email ou senha inválidos');
            });
          } else {
            throw new Error('Erro no servidor');
          }
        })
        .catch(error => {
          // Mostrar mensagem de erro
          errorMessage.textContent = error.message || 'Ocorreu um erro ao tentar fazer login. Por favor, tente novamente.';
          errorMessage.classList.remove('d-none');

          // Resetar o botão
          loginButton.disabled = false;
          loginButton.innerHTML = 'Entrar';

          console.error('Erro de login:', error);
        });
      });
    }
  });
</script>
