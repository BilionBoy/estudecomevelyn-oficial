<div class="container py-5">
  <div class="row">
    <div class="col-12">
      <h1 class="cart-title">Seu Carrinho</h1>
      <% if @itens.any? %>
        <div class="cart-container">
          <div class="row">
            <div class="col-lg-8">
              <div class="cart-items-container">
                <% @itens.each do |item| %>
                  <div class="cart-item">
                    <div class="cart-item-image">
                      <% if item.i_produto.imagem.attached? %>
                        <%= image_tag url_for(item.i_produto.imagem), class: "img-fluid" %>
                      <% else %>
                        <div class="no-image-placeholder">
                          <i class="fas fa-image"></i>
                        </div>
                      <% end %>
                    </div>
                    <div class="cart-item-details">
                      <h3 class="cart-item-title"><%= item.i_produto.nome %></h3>
                      <div class="cart-item-price">
                        <span class="current-price">R$ <%= number_to_currency(item.i_produto.preco, unit: '', separator: ',', delimiter: '.') %></span>
                      </div>
                    </div>
                    <div class="cart-item-remove">
                      <td>
                        <%= button_to "Remover", remover_item_store_carrinho_path(produto_id: item.i_produto.id), method: :delete, data: { confirm: "Tem certeza que deseja remover este produto?" }, class: "btn btn-sm btn-danger" %>
                      </td>
                    </div>
                  </div>
                <% end %>
              </div>
              <div class="cart-actions mt-4">
                <%= link_to root_path, class: "btn btn-outline-secondary" do %>
                  <i class="fas fa-arrow-left me-2"></i> Continuar Comprando
                <% end %>
                <%= button_to limpar_store_carrinho_path, method: :delete, class: "btn btn-outline-danger", data: { confirm: "Tem certeza que deseja esvaziar o carrinho?" } do %>
                  <i class="fas fa-trash me-2"></i> Limpar Carrinho
                <% end %>
              </div>
            </div>
            <div class="col-lg-4">
              <div class="cart-summary">
                <h3 class="summary-title">Resumo do Pedido</h3>
                <div class="summary-items">
                  <div class="summary-item">
                    <span class="summary-item-label">Subtotal</span>
                    <span class="summary-item-value">R$ <%= number_to_currency(@total, unit: '', separator: ',', delimiter: '.') %></span>
                  </div>
                  <div class="summary-item">
                    <span class="summary-item-label">Frete</span>
                    <span class="summary-item-value">Calculado no próximo passo</span>
                  </div>
                </div>
                <div class="summary-total">
                  <span class="summary-total-label">Total</span>
                  <span class="summary-total-value">R$ <%= number_to_currency(@total, unit: '', separator: ',', delimiter: '.') %></span>
                </div>
                <div class="summary-actions">
                  <%= link_to "#", class: "btn btn-primary btn-block" do %>
                    <i class="fas fa-lock me-2"></i> Finalizar Compra
                  <% end %>
                </div>
                <div class="summary-info mt-4">
                  <div class="payment-methods">
                    <h4>Métodos de Pagamento</h4>
                    <div class="payment-icons">
                      <i class="fab fa-cc-visa"></i>
                      <i class="fab fa-cc-mastercard"></i>
                      <i class="fab fa-cc-amex"></i>
                      <i class="fab fa-pix"></i>
                    </div>
                  </div>
                  <div class="secure-checkout mt-3">
                    <i class="fas fa-shield-alt me-2"></i>
                    <span>Compra 100% Segura</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% else %>
        <div class="empty-cart">
          <div class="empty-cart-icon">
            <i class="fas fa-shopping-cart"></i>
          </div>
          <h2>Seu carrinho está vazio</h2>
          <p>Parece que você ainda não adicionou nenhum produto ao seu carrinho.</p>
          <%= link_to "Voltar à loja", root_path, class: "btn btn-primary mt-3" %>
        </div>
      <% end %>
    </div>
  </div>
</div>