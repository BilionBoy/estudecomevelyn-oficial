<style>
  :root {
    --primary: #e42278;
    --primary-dark: #c41864;
    --primary-light: #f5d3dd;
    --primary-lighter: #fdf0f5;
    --secondary: #1a1a2e;
    --text-dark: #333333;
    --text-light: #8a8a8a;
    --background: #f9f9f9;
    --white: #ffffff;
    --border-radius: 16px;
    --box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    --transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Poppins', sans-serif;
    background-color: var(--background);
    color: var(--text-dark);
    line-height: 1.6;
    background-image: linear-gradient(135deg, #f9f9f9 0%, #f5f5f5 100%);
    min-height: 100vh;
    overflow-x: hidden;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 15px;
  }

  /* Checkout Container */
  .checkout-container {
    padding: 40px 0 60px;
    min-height: calc(100vh - 80px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
</style>
<main class="container checkout-container">
  <h1 class="checkout-title">Finalizar Compra</h1>
  <!-- Checkout Steps Indicator -->
  <div class="checkout-steps">
    <div class="step active" id="step-1">
      1
      <span class="step-label">Informações</span>
    </div>
    <div class="step" id="step-2">
      2
      <span class="step-label">Pagamento</span>
    </div>
    <div class="step" id="step-3">
      3
      <span class="step-label">Confirmação</span>
    </div>
  </div>
  <!-- Checkout Card -->
  <div class="checkout-card">
    <!-- Left Side - Forms -->
    <div class="checkout-card-left">
      <!-- Formulário principal - NÃO submete até o final -->
      <form id="checkout-form" action="<%= store_checkout_path %>" method="post">
        <%= csrf_meta_tags %>
        <!-- Step 1: Personal Information -->
        <div class="checkout-step active" id="step-1-content">
          <h2 class="step-title">
            <i class="fas fa-user-circle"></i>
            Informações Pessoais
          </h2>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="nome">Nome Completo</label>
              <input type="text" class="form-control" id="nome" name="nome" placeholder="Digite seu nome completo" value="<%= current_user.nome if current_user %>" required>
              <div class="invalid-feedback">Por favor, informe seu nome completo.</div>
            </div>
            <div class="form-group">
              <label class="form-label" for="email">E-mail</label>
              <input type="email" class="form-control" id="email" name="email" placeholder="Digite seu e-mail" value="<%= current_user.email if current_user %>" required>
              <div class="invalid-feedback">Por favor, informe um e-mail válido.</div>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="cpf">CPF</label>
              <input type="text" class="form-control" id="cpf" name="cpf" placeholder="000.000.000-00" value="<%= current_user.cpf if current_user.respond_to?(:cpf) %>" required>
              <div class="invalid-feedback">Por favor, informe um CPF válido.</div>
            </div>
            <div class="form-group">
              <label class="form-label" for="telefone">Telefone</label>
              <input type="tel" class="form-control" id="telefone" name="telefone" placeholder="(00) 00000-0000" value="<%= current_user.telefone if current_user.respond_to?(:telefone) %>" required>
              <div class="invalid-feedback">Por favor, informe um telefone válido.</div>
            </div>
          </div>
          <div class="step-buttons">
            <!-- Botão tipo button para evitar submissão do formulário -->
            <a href="#step-2-content" class="btn btn-next" id="btn-to-step-2" onclick="validateAndProceed(1, 2); return false;">
              Continuar para Pagamento
              <i class="fas fa-arrow-right"></i>
            </a>
          </div>
        </div>
        <!-- Step 2: Payment Method (unchanged) -->
        <div class="checkout-step" id="step-2-content">
          <!-- Your existing payment method code -->
          <h2 class="step-title">
            <i class="fas fa-credit-card"></i>
            Método de Pagamento
          </h2>
          <div class="payment-methods">
            <div class="payment-method active" id="credit-card-option">
              <div class="payment-method-icon">
                <i class="fas fa-credit-card"></i>
              </div>
              <div class="payment-method-name">Cartão de Crédito</div>
              <div class="payment-method-description">Pague em até 12x</div>
            </div>
            <div class="payment-method" id="boleto-option">
              <div class="payment-method-icon">
                <i class="fas fa-barcode"></i>
              </div>
              <div class="payment-method-name">Boleto</div>
              <div class="payment-method-description">Vencimento em 3 dias</div>
            </div>
            <div class="payment-method" id="pix-option">
              <div class="payment-method-icon">
                <i class="fas fa-qrcode"></i>
              </div>
              <div class="payment-method-name">PIX</div>
              <div class="payment-method-description">Aprovação imediata</div>
            </div>
          </div>
          <!-- Credit Card Form -->
          <div id="credit-card-form">
            <!-- Your existing credit card form -->
            <div class="credit-card-container">
              <div class="credit-card">
                <div class="card-chip"></div>
                <div class="card-number" id="card-number-display">•••• •••• •••• ••••</div>
                <div class="card-holder">Nome no cartão</div>
                <div class="card-holder-name" id="card-name-display">Seu Nome</div>
                <div class="card-expiry">
                  <div class="card-expiry-label">Validade</div>
                  <div class="card-expiry-date" id="card-expiry-display">MM/AA</div>
                </div>
                <div class="card-brand">
                  <i class="fab fa-cc-visa"></i>
                </div>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="card-number">Número do Cartão</label>
                <input type="text" class="form-control" id="card-number" name="card_number" placeholder="0000 0000 0000 0000" required>
                <div class="invalid-feedback">Por favor, informe um número de cartão válido.</div>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" for="card-name">Nome no Cartão</label>
              <input type="text" class="form-control" id="card-name" name="card_name" placeholder="Nome como está no cartão" required>
              <div class="invalid-feedback">Por favor, informe o nome como está no cartão.</div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="card-expiry">Data de Validade</label>
                <input type="text" class="form-control" id="card-expiry" name="card_expiry" placeholder="MM/AA" required>
                <div class="invalid-feedback">Por favor, informe uma data válida.</div>
              </div>
              <div class="form-group">
                <label class="form-label" for="card-cvv">CVV</label>
                <input type="text" class="form-control" id="card-cvv" name="card_cvv" placeholder="123" required>
                <div class="invalid-feedback">Por favor, informe o código de segurança.</div>
              </div>
            </div>
          </div>
          <!-- Boleto Form (Hidden by default) -->
          <div id="boleto-form" style="display: none;">
            <!-- Your existing boleto form -->
            <div style="background-color: var(--primary-lighter); padding: 20px; border-radius: 12px; margin-bottom: 20px;">
              <div style="font-weight: 600; margin-bottom: 10px; color: var(--primary);">
                <i class="fas fa-info-circle"></i> Informações do Boleto
              </div>
              <p style="font-size: 0.95rem; line-height: 1.6;">
                Ao finalizar sua compra, você receberá o boleto bancário por e-mail. O boleto também estará disponível na área "Meus Pedidos" da sua conta.
              </p>
              <p style="font-size: 0.95rem; line-height: 1.6; margin-top: 10px;">
                <strong style="color: var(--primary);">Importante:</strong> O boleto tem vencimento em 3 dias úteis. Após o pagamento, a confirmação pode levar até 3 dias úteis.
              </p>
            </div>
          </div>
          <!-- PIX Form (Hidden by default) -->
          <div id="pix-form" style="display: none;">
            <!-- Your existing PIX form -->
            <div style="background-color: var(--primary-lighter); padding: 20px; border-radius: 12px; margin-bottom: 20px;">
              <div style="font-weight: 600; margin-bottom: 10px; color: var(--primary);">
                <i class="fas fa-info-circle"></i> Informações do PIX
              </div>
              <p style="font-size: 0.95rem; line-height: 1.6;">
                Ao finalizar sua compra, você receberá um QR Code PIX para pagamento. O pagamento via PIX é processado instantaneamente.
              </p>
              <p style="font-size: 0.95rem; line-height: 1.6; margin-top: 10px;">
                <strong style="color: var(--primary);">Importante:</strong> O QR Code tem validade de 30 minutos. Após esse período, será necessário gerar um novo.
              </p>
            </div>
            <div style="width: 200px; height: 200px; margin: 20px auto; background-color: white; padding: 15px; border-radius: 12px; box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);">
              <img src="https://upload.wikimedia.org/wikipedia/commons/d/d0/QR_code_for_mobile_English_Wikipedia.svg" alt="QR Code PIX" style="width: 100%; height: 100%; object-fit: contain;">
            </div>
          </div>
          <div class="step-buttons">
            <a href="#step-1-content" class="btn btn-prev" onclick="showStep(1); return false;">
              <i class="fas fa-arrow-left"></i>
              Voltar para Informações
            </a>
            <a href="#step-3-content" class="btn btn-next" onclick="validateAndProceed(2, 3); return false;">
              Revisar e Confirmar
              <i class="fas fa-arrow-right"></i>
            </a>
          </div>
        </div>
        <!-- Step 3: Confirmation -->
        <div class="checkout-step" id="step-3-content">
          <h2 class="step-title">
            <i class="fas fa-check-circle"></i>
            Revisar e Confirmar
          </h2>
          <div style="background-color: var(--primary-lighter); padding: 20px; border-radius: 12px; margin-bottom: 30px;">
            <h3 style="font-size: 1.2rem; font-weight: 600; margin-bottom: 15px; color: var(--primary);">Informações Pessoais</h3>
            <div style="display: flex; flex-wrap: wrap; gap: 20px;">
              <div style="flex: 1; min-width: 200px;">
                <div style="font-weight: 500; margin-bottom: 5px; color: var(--text-light);">Nome Completo</div>
                <div id="confirm-name" style="font-size: 1.1rem;">-</div>
              </div>
              <div style="flex: 1; min-width: 200px;">
                <div style="font-weight: 500; margin-bottom: 5px; color: var(--text-light);">E-mail</div>
                <div id="confirm-email" style="font-size: 1.1rem;">-</div>
              </div>
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 20px; margin-top: 15px;">
              <div style="flex: 1; min-width: 200px;">
                <div style="font-weight: 500; margin-bottom: 5px; color: var(--text-light);">CPF</div>
                <div id="confirm-cpf" style="font-size: 1.1rem;">-</div>
              </div>
              <div style="flex: 1; min-width: 200px;">
                <div style="font-weight: 500; margin-bottom: 5px; color: var(--text-light);">Telefone</div>
                <div id="confirm-telefone" style="font-size: 1.1rem;">-</div>
              </div>
            </div>
          </div>
          <div style="background-color: var(--primary-lighter); padding: 20px; border-radius: 12px; margin-bottom: 30px;">
            <h3 style="font-size: 1.2rem; font-weight: 600; margin-bottom: 15px; color: var(--primary);">Método de Pagamento</h3>
            <div style="display: flex; align-items: center; gap: 15px;">
              <div id="confirm-payment-icon" style="font-size: 2rem; color: var(--primary);">
                <i class="fas fa-credit-card"></i>
              </div>
              <div>
                <div id="confirm-payment-method" style="font-size: 1.1rem; font-weight: 600;">Cartão de Crédito</div>
                <div id="confirm-payment-details" style="color: var(--text-light); font-size: 0.9rem;">Terminado em •••• <span id="card-last-digits">0000</span></div>
              </div>
            </div>
          </div>
          <div class="step-buttons">
            <!-- Botão de Confirmar Compra -->
            <div class="step-buttons">
              <a href="#step-2-content" class="btn btn-prev" onclick="showStep(2); return false;">
                <i class="fas fa-arrow-left"></i>
                Voltar para Pagamento
              </a>
              <button type="submit" class="btn btn-confirm">
                Confirmar Compra
                <i class="fas fa-lock"></i>
              </button>
            </div>
          </div>
        </div>
        <!-- Campo oculto para indicar a ação -->
        <input type="hidden" name="payment_method" id="payment_method" value="credit_card">
      </form>
    </div>
    <!-- Right Side - Order Summary -->
    <div class="checkout-card-right">
    </div>
  </div>
</main>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Máscaras para os campos
    if (typeof IMask !== 'undefined') {
      // CPF mask
      IMask(document.getElementById('cpf'), {
        mask: '000.000.000-00'
      });

      // Phone mask
      IMask(document.getElementById('telefone'), {
        mask: '(00) 00000-0000'
      });

      // Credit card number mask
      IMask(document.getElementById('card-number'), {
        mask: '0000 0000 0000 0000'
      });

      // Expiry date mask
      IMask(document.getElementById('card-expiry'), {
        mask: 'MM/YY',
        blocks: {
          MM: {
            mask: IMask.MaskedRange,
            from: 1,
            to: 12
          },
          YY: {
            mask: IMask.MaskedRange,
            from: 23,
            to: 33
          }
        }
      });

      // CVV mask
      IMask(document.getElementById('card-cvv'), {
        mask: '000'
      });
    }

    // Atualizar o cartão de crédito visual conforme digitação
    const cardNumberInput = document.getElementById('card-number');
    const cardNameInput = document.getElementById('card-name');
    const cardExpiryInput = document.getElementById('card-expiry');

    if (cardNumberInput) {
      cardNumberInput.addEventListener('input', function() {
        let value = this.value.replace(/\s/g, '');
        let displayValue = value.padEnd(16, '•').replace(/(.{4})/g, '$1 ').trim();
        document.getElementById('card-number-display').textContent = displayValue;

        // Atualizar os últimos dígitos na confirmação
        if (value.length >= 4) {
          document.getElementById('card-last-digits').textContent = value.slice(-4);
        } else {
          document.getElementById('card-last-digits').textContent = '0000';
        }
      });
    }

    if (cardNameInput) {
      cardNameInput.addEventListener('input', function() {
        document.getElementById('card-name-display').textContent = this.value || 'Seu Nome';
      });
    }

    if (cardExpiryInput) {
      cardExpiryInput.addEventListener('input', function() {
        document.getElementById('card-expiry-display').textContent = this.value || 'MM/AA';
      });
    }
  });

  // Validação e navegação entre etapas
  function validateAndProceed(currentStep, nextStep) {
    let isValid = true;

    if (currentStep === 1) {
      // Validar campos da etapa 1
      const requiredFields = ['nome', 'email', 'cpf', 'telefone'];
      requiredFields.forEach(field => {
        const input = document.getElementById(field);
        if (!input.value.trim()) {
          input.classList.add('is-invalid');
          isValid = false;
        } else {
          input.classList.remove('is-invalid');

          // Validações específicas
          if (field === 'email') {
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(input.value)) {
              input.classList.add('is-invalid');
              isValid = false;
            }
          }

          if (field === 'cpf') {
            // Validação básica de CPF (apenas formato)
            const cpfRegex = /^\d{3}\.\d{3}\.\d{3}-\d{2}$/;
            if (!cpfRegex.test(input.value)) {
              input.classList.add('is-invalid');
              isValid = false;
            }
          }

          if (field === 'telefone') {
            // Validação básica de telefone (apenas formato)
            const telefoneRegex = /^$$\d{2}$$ \d{5}-\d{4}$/;
            if (!telefoneRegex.test(input.value)) {
              input.classList.add('is-invalid');
              isValid = false;
            }
          }
        }
      });
    } else if (currentStep === 2) {
      // Validar campos da etapa 2 baseado no método de pagamento selecionado
      const paymentMethod = document.getElementById('payment_method').value;

      if (paymentMethod === 'credit_card') {
        const cardFields = ['card-number', 'card-name', 'card-expiry', 'card-cvv'];
        cardFields.forEach(field => {
          const input = document.getElementById(field);
          if (!input.value.trim()) {
            input.classList.add('is-invalid');
            isValid = false;
          } else {
            input.classList.remove('is-invalid');
          }
        });
      }
    }

    if (isValid) {
      showStep(nextStep);
    }
  }

  // Função para mostrar etapas
  function showStep(stepNumber) {
    // Esconde todas as etapas
    document.querySelectorAll('.checkout-step').forEach(step => {
      step.classList.remove('active');
    });

    // Mostra a etapa selecionada
    document.getElementById('step-' + stepNumber + '-content').classList.add('active');

    // Atualiza os indicadores de etapa
    document.querySelectorAll('.step').forEach(step => {
      step.classList.remove('active', 'completed');
    });

    for (let i = 1; i <= 3; i++) {
      if (i < stepNumber) {
        document.getElementById('step-' + i).classList.add('completed');
      } else if (i === stepNumber) {
        document.getElementById('step-' + i).classList.add('active');
      }
    }

    // Atualiza os dados de confirmação na etapa 3
    if (stepNumber === 3) {
      document.getElementById('confirm-name').textContent = document.getElementById('nome').value || '-';
      document.getElementById('confirm-email').textContent = document.getElementById('email').value || '-';
      document.getElementById('confirm-cpf').textContent = document.getElementById('cpf').value || '-';
      document.getElementById('confirm-telefone').textContent = document.getElementById('telefone').value || '-';

      // Atualiza informações do método de pagamento
      const paymentMethod = document.getElementById('payment_method').value;
      const paymentIcon = document.getElementById('confirm-payment-icon');
      const paymentMethodText = document.getElementById('confirm-payment-method');
      const paymentDetails = document.getElementById('confirm-payment-details');

      if (paymentMethod === 'credit_card') {
        paymentIcon.innerHTML = '<i class="fas fa-credit-card"></i>';
        paymentMethodText.textContent = 'Cartão de Crédito';
        const lastDigits = document.getElementById('card-number').value.replace(/\s/g, '').slice(-4) || '0000';
        paymentDetails.textContent = 'Terminado em •••• ' + lastDigits;
      } else if (paymentMethod === 'boleto') {
        paymentIcon.innerHTML = '<i class="fas fa-barcode"></i>';
        paymentMethodText.textContent = 'Boleto Bancário';
        paymentDetails.textContent = 'Vencimento em 3 dias úteis';
      } else if (paymentMethod === 'pix') {
        paymentIcon.innerHTML = '<i class="fas fa-qrcode"></i>';
        paymentMethodText.textContent = 'PIX';
        paymentDetails.textContent = 'Pagamento instantâneo';
      }
    }
  }

  // Adiciona eventos de clique para os métodos de pagamento
  document.querySelectorAll('.payment-method').forEach(method => {
    method.addEventListener('click', function() {
      // Remove a classe active de todos os métodos
      document.querySelectorAll('.payment-method').forEach(m => {
        m.classList.remove('active');
      });

      // Adiciona a classe active ao método clicado
      this.classList.add('active');

      // Esconde todos os formulários
      document.getElementById('credit-card-form').style.display = 'none';
      document.getElementById('boleto-form').style.display = 'none';
      document.getElementById('pix-form').style.display = 'none';

      // Mostra o formulário correspondente
      if (this.id === 'credit-card-option') {
        document.getElementById('credit-card-form').style.display = 'block';
        document.getElementById('payment_method').value = 'credit_card';
      } else if (this.id === 'boleto-option') {
        document.getElementById('boleto-form').style.display = 'block';
        document.getElementById('payment_method').value = 'boleto';
      } else if (this.id === 'pix-option') {
        document.getElementById('pix-form').style.display = 'block';
        document.getElementById('payment_method').value = 'pix';
      }
    });
  });

  // Validação do formulário antes do envio
  document.getElementById('checkout-form').addEventListener('submit', function(event) {
    // Validar todos os campos necessários antes de enviar
    let isValid = true;

    // Validar campos da etapa 1
    const personalFields = ['nome', 'email', 'cpf', 'telefone'];
    personalFields.forEach(field => {
      const input = document.getElementById(field);
      if (!input.value.trim()) {
        input.classList.add('is-invalid');
        isValid = false;
      }
    });

    // Validar campos da etapa 2 baseado no método de pagamento
    const paymentMethod = document.getElementById('payment_method').value;
    if (paymentMethod === 'credit_card') {
      const cardFields = ['card-number', 'card-name', 'card-expiry', 'card-cvv'];
      cardFields.forEach(field => {
        const input = document.getElementById(field);
        if (!input.value.trim()) {
          input.classList.add('is-invalid');
          isValid = false;
        }
      });
    }

    if (!isValid) {
      event.preventDefault();
      alert('Por favor, preencha todos os campos obrigatórios antes de finalizar a compra.');
    }
  });

  function validateAndProceed(currentStep, nextStep) {
  if (currentStep === 1) {
    // Validação básica
    const nome = document.getElementById('nome').value;
    const email = document.getElementById('email').value;
    const cpf = document.getElementById('cpf').value;
    const telefone = document.getElementById('telefone').value;

    if (!nome || !email || !cpf || !telefone) {
      alert('Preencha todos os campos obrigatórios.');
      return;
    }

    // Preenche etapa 3
    document.getElementById('confirm-name').innerText = nome;
    document.getElementById('confirm-email').innerText = email;
    document.getElementById('confirm-cpf').innerText = cpf;
    document.getElementById('confirm-telefone').innerText = telefone;
  }

  showStep(nextStep);
  }

  function showStep(stepNumber) {
  document.querySelectorAll('.checkout-step').forEach(step => step.classList.remove('active'));
  document.getElementById(`step-${stepNumber}-content`).classList.add('active');

  document.querySelectorAll('.checkout-steps .step').forEach(step => step.classList.remove('active'));
  document.getElementById(`step-${stepNumber}`).classList.add('active');
  }
</script>
