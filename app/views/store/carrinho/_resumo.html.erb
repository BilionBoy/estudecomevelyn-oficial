<style>
  :root {
    --primary: #e42278;
    --primary-dark: #c41864;
    --primary-light: #f5d3dd;
    --secondary: #1a1a2e;
    --text-dark: #333333;
    --text-light: #8a8a8a;
    --background: #f9f9f9;
    --white: #ffffff;
    --border-radius: 12px;
    --box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
    --transition: all 0.3s ease;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Poppins', sans-serif;
    background-color: var(--background);
    color: var(--text-dark);
    line-height: 1.6;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 15px;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -15px;
  }

  .col-md-8, .col-md-4 {
    padding: 0 15px;
    width: 100%;
  }

  @media (min-width: 768px) {
    .col-md-8 {
      width: 66.66%;
    }
    .col-md-4 {
      width: 33.33%;
    }
  }


  /* Checkout Container */
  .checkout-container {
    padding: 40px 0;
  }

  .checkout-title {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: 2.5rem;
    color: var(--secondary);
    margin-bottom: 30px;
    text-align: center;
    position: relative;
  }

  .checkout-title:after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 3px;
    background-color: var(--primary);
    border-radius: 3px;
  }

  /* Checkout Sections */
  .checkout-section {
    background-color: var(--white);
    border-radius: var(--border-radius);
    box-shadow: var(--box-shadow);
    padding: 30px;
    margin-bottom: 30px;
    transition: var(--transition);
  }

  .checkout-section:hover {
    box-shadow: 0 12px 30px rgba(228, 34, 120, 0.1);
  }

  .section-title {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: 1.5rem;
    color: var(--secondary);
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--primary-light);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .section-title i {
    color: var(--primary);
  }

  /* Form Styles */
  .form-group {
    margin-bottom: 20px;
  }

  .form-label {
    display: block;
    margin-bottom: 8px;
    font-weight: 500;
    color: var(--secondary);
  }

  .form-control {
    width: 100%;
    padding: 12px 15px;
    border: 1px solid #e1e1e1;
    border-radius: 8px;
    font-family: 'Poppins', sans-serif;
    font-size: 1rem;
    transition: var(--transition);
  }

  .form-control:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(228, 34, 120, 0.1);
    outline: none;
  }

  .form-row {
    display: flex;
    gap: 20px;
    margin-bottom: 0;
  }

  .form-row .form-group {
    flex: 1;
  }

  /* Payment Methods */
  .payment-methods {
    display: flex;
    gap: 15px;
    margin-bottom: 25px;
  }

  .payment-method {
    flex: 1;
    min-width: 120px;
    padding: 15px;
    border: 2px solid #e1e1e1;
    border-radius: var(--border-radius);
    text-align: center;
    cursor: pointer;
    transition: var(--transition);
    position: relative;
  }

  .payment-method:hover {
    border-color: var(--primary-light);
    background-color: rgba(228, 34, 120, 0.02);
  }

  .payment-method.active {
    border-color: var(--primary);
    background-color: rgba(228, 34, 120, 0.05);
  }

  .payment-method.active:before {
    content: '\f00c';
    font-family: 'Font Awesome 6 Free';
    font-weight: 900;
    position: absolute;
    top: -10px;
    right: -10px;
    background-color: var(--primary);
    color: white;
    width: 25px;
    height: 25px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
  }

  .payment-method-icon {
    font-size: 2.2rem;
    margin-bottom: 10px;
    color: var(--secondary);
    transition: var(--transition);
  }

  .payment-method.active .payment-method-icon {
    color: var(--primary);
  }

  .payment-method-name {
    font-size: 1rem;
    font-weight: 500;
  }

  .payment-logos {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 20px;
    flex-wrap: wrap;
  }

  .payment-logo {
    width: 40px;
    height: 25px;
    object-fit: contain;
    opacity: 0.7;
    transition: var(--transition);
  }

  .payment-logo:hover {
    opacity: 1;
  }

  /* Order Summary */
  .order-item {
    display: flex;
    align-items: center;
    padding: 15px 0;
    border-bottom: 1px solid #f0f0f0;
  }

  .order-item:last-child {
    border-bottom: none;
  }

  .order-item-image {
    width: 70px;
    height: 70px;
    border-radius: 10px;
    overflow: hidden;
    margin-right: 15px;
    background-color: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .order-item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .no-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-light);
    font-size: 1.5rem;
  }

  .order-item-details {
    flex: 1;
  }

  .order-item-title {
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--secondary);
    margin-bottom: 5px;
  }

  .order-item-info {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    font-size: 0.9rem;
    color: var(--text-light);
  }

  .order-item-price {
    font-weight: 600;
    color: var(--primary);
    font-size: 1.1rem;
    text-align: right;
  }

  .order-item-remove {
    color: var(--text-light);
    font-size: 0.85rem;
    text-decoration: none;
    margin-top: 5px;
    display: inline-block;
    transition: var(--transition);
  }

  .order-item-remove:hover {
    color: var(--primary);
  }

  .order-summary-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
    font-size: 1rem;
  }

  .order-summary-label {
    color: var(--text-light);
  }

  .order-summary-value {
    font-weight: 500;
    color: var(--text-dark);
  }

  .order-total {
    display: flex;
    justify-content: space-between;
    padding-top: 15px;
    border-top: 2px solid var(--primary-light);
    margin-top: 15px;
  }

  .order-total-label {
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--secondary);
  }

  .order-total-value {
    font-weight: 700;
    font-size: 1.4rem;
    color: var(--primary);
  }

  /* Coupon */
  .coupon-container {
    margin-top: 20px;
  }

  .input-group {
    display: flex;
  }

  .input-group .form-control {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-right: none;
  }

  .input-group-btn {
    background-color: var(--primary);
    color: white;
    border: none;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    padding: 0 20px;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition);
  }

  .input-group-btn:hover {
    background-color: var(--primary-dark);
  }

  /* Checkout Button */
  .btn-checkout {
    display: block;
    width: 100%;
    padding: 15px;
    background-color: var(--primary);
    color: white;
    border: none;
    border-radius: var(--border-radius);
    font-family: 'Poppins', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
    text-align: center;
    text-decoration: none;
    margin-top: 25px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .btn-checkout:hover {
    background-color: var(--primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(228, 34, 120, 0.2);
  }

  /* Security Info */
  .security-info {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
    color: var(--text-light);
    font-size: 0.9rem;
    flex-wrap: wrap;
  }

  .security-badge {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    background-color: #f5f5f5;
    border-radius: 50px;
  }

  .security-badge i {
    color: var(--primary);
  }

  /* Responsive */
  @media (max-width: 767px) {
    .form-row {
      flex-direction: column;
      gap: 0;
    }

    .payment-methods {
      flex-direction: column;
    }

    .payment-method {
      padding: 12px;
    }

    .checkout-section {
      padding: 20px;
    }

    .order-item-info {
      flex-direction: column;
      gap: 5px;
    }
  }
</style>
<!-- Main Content -->
<main class="container checkout-container">
  <div class="row">
    <!-- Left Column - Forms -->
    <div class="col-md-8">
      <!-- Personal Information -->
      <section class="checkout-section">
        <h2 class="section-title">
          <i class="fas fa-user-circle"></i>
          Informações Pessoais
        </h2>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="nome">Nome Completo</label>
            <input type="text" class="form-control" id="nome" placeholder="Digite seu nome completo">
          </div>
          <div class="form-group">
            <label class="form-label" for="email">E-mail</label>
            <input type="email" class="form-control" id="email" placeholder="Digite seu e-mail">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="cpf">CPF</label>
            <input type="text" class="form-control" id="cpf" placeholder="000.000.000-00">
          </div>
          <div class="form-group">
            <label class="form-label" for="telefone">Telefone</label>
            <input type="tel" class="form-control" id="telefone" placeholder="(00) 00000-0000">
          </div>
        </div>
      </section>
      <!-- Payment Method -->
      <section class="checkout-section">
        <h2 class="section-title">
          <i class="fas fa-credit-card"></i>
          Método de Pagamento
        </h2>
        <div class="payment-methods">
          <div class="payment-method active" id="credit-card-option">
            <div class="payment-method-icon">
              <i class="fas fa-credit-card"></i>
            </div>
            <div class="payment-method-name">Cartão de Crédito</div>
          </div>
          <div class="payment-method" id="boleto-option">
            <div class="payment-method-icon">
              <i class="fas fa-barcode"></i>
            </div>
            <div class="payment-method-name">Boleto</div>
          </div>
          <div class="payment-method" id="pix-option">
            <div class="payment-method-icon">
              <i class="fas fa-qrcode"></i>
            </div>
            <div class="payment-method-name">PIX</div>
          </div>
        </div>
        <!-- Credit Card Form -->
        <div id="credit-card-form">
          <div class="form-group">
            <label class="form-label" for="card-number">Número do Cartão</label>
            <input type="text" class="form-control" id="card-number" placeholder="0000 0000 0000 0000">
          </div>
          <div class="form-group">
            <label class="form-label" for="card-name">Nome no Cartão</label>
            <input type="text" class="form-control" id="card-name" placeholder="Nome como está no cartão">
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="card-expiry">Data de Validade</label>
              <input type="text" class="form-control" id="card-expiry" placeholder="MM/AA">
            </div>
            <div class="form-group">
              <label class="form-label" for="card-cvv">CVV</label>
              <input type="text" class="form-control" id="card-cvv" placeholder="123">
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="card-installments">Parcelas</label>
            <select class="form-control" id="card-installments">
              <option value="1">1x de R$ 101,00 sem juros</option>
              <option value="2">2x de R$ 50,50 sem juros</option>
              <option value="3">3x de R$ 33,67 sem juros</option>
              <option value="4">4x de R$ 25,25 sem juros</option>
              <option value="5">5x de R$ 20,20 sem juros</option>
              <option value="6">6x de R$ 16,83 sem juros</option>
            </select>
          </div>
        </div>
        <!-- Payment Logos -->
        <div class="payment-logos">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/visa/visa-original.svg" alt="Visa" class="payment-logo">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mastercard/mastercard-original.svg" alt="Mastercard" class="payment-logo">
          <img src="https://logodownload.org/wp-content/uploads/2020/02/pix-bc-logo-1-1.png" alt="PIX" class="payment-logo" style="width: 35px;">
          <img src="https://logodownload.org/wp-content/uploads/2017/04/boleto-logo.png" alt="Boleto" class="payment-logo" style="width: 50px;">
          <img src="https://logodownload.org/wp-content/uploads/2017/11/elo-logo-5.png" alt="Elo" class="payment-logo">
          <img src="https://logodownload.org/wp-content/uploads/2017/10/hipercard-logo-1.png" alt="Hipercard" class="payment-logo">
        </div>
      </section>
    </div>
    <!-- Right Column - Order Summary -->
    <div class="col-md-4">
      <section class="checkout-section">
        <h2 class="section-title">
          <i class="fas fa-shopping-cart"></i>
          Resumo do Pedido
        </h2>
        <!-- Order Items -->
        <div class="order-items">
          <% if carrinho.present? && carrinho.i_itens_carrinhos.any? %>
            <% carrinho.i_itens_carrinhos.each do |item| %>
              <div class="order-item">
                <div class="order-item-image">
                  <% if item.i_produto.respond_to?(:imagem) && item.i_produto.imagem.attached? %>
                    <%= image_tag url_for(item.i_produto.imagem), alt: item.i_produto.nome %>
                  <% else %>
                    <div class="no-image-placeholder">
                      <i class="fas fa-book"></i>
                    </div>
                  <% end %>
                </div>
                <div class="order-item-details">
                  <h4 class="order-item-title"><%= item.i_produto.nome %></h4>
                  <div class="order-item-info">
                    <span>Quantidade: <%= item.quantidade %></span>
                    <span>Preço: <%= number_to_currency(item.preco_unitario, unit: "R$") %></span>
                  </div>
                  <a href="#" class="order-item-remove">
                    <i class="fas fa-times"></i> Remover
                  </a>
                </div>
                <div class="order-item-price">
                  <%= number_to_currency(item.subtotal, unit: "R$") %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
        <!-- Order Summary -->
        <div class="order-summary">
          <div class="order-summary-row">
            <span class="order-summary-label">Subtotal</span>
            <span class="order-summary-value"><%= number_to_currency(carrinho.total, unit: "R$") %></span>
          </div>
          <div class="order-summary-row">
            <span class="order-summary-label">Frete</span>
            <span class="order-summary-value">Grátis</span>
          </div>
          <div class="order-summary-row">
            <span class="order-summary-label">Desconto</span>
            <span class="order-summary-value">R$ 0,00</span>
          </div>
          <div class="order-total">
            <span class="order-total-label">Total</span>
            <span class="order-total-value"><%= number_to_currency(carrinho.total, unit: "R$") %></span>
          </div>
        </div>
        <!-- Coupon -->
        <div class="coupon-container">
          <label class="form-label" for="coupon">Cupom de Desconto</label>
          <div class="input-group">
            <input type="text" class="form-control" id="coupon" placeholder="Digite seu cupom">
            <button class="input-group-btn">Aplicar</button>
          </div>
        </div>
        <!-- Checkout Button -->
        <button type="submit" class="btn-checkout">
          <i class="fas fa-lock"></i>
          Finalizar Pagamento
        </button>
        <!-- Security Info -->
        <div class="security-info">
          <div class="security-badge">
            <i class="fas fa-shield-alt"></i>
            <span>Compra 100% Segura</span>
          </div>
          <div class="security-badge">
            <i class="fas fa-lock"></i>
            <span>Pagamento Protegido</span>
          </div>
          <div class="security-badge">
            <i class="fas fa-truck"></i>
            <span>Entrega Garantida</span>
          </div>
        </div>
      </section>
    </div>
  </div>
</main>
<script>
  // JavaScript para alternar entre métodos de pagamento
  document.addEventListener('DOMContentLoaded', function() {
    const creditCardOption = document.getElementById('credit-card-option');
    const boletoOption = document.getElementById('boleto-option');
    const pixOption = document.getElementById('pix-option');
    const creditCardForm = document.getElementById('credit-card-form');

    // Função para remover a classe 'active' de todos os métodos
    function resetActivePaymentMethod() {
      creditCardOption.classList.remove('active');
      boletoOption.classList.remove('active');
      pixOption.classList.remove('active');
    }

    // Adicionar event listeners para os métodos de pagamento
    creditCardOption.addEventListener('click', function() {
      resetActivePaymentMethod();
      creditCardOption.classList.add('active');
      creditCardForm.style.display = 'block';
    });

    boletoOption.addEventListener('click', function() {
      resetActivePaymentMethod();
      boletoOption.classList.add('active');
      creditCardForm.style.display = 'none';
    });

    pixOption.addEventListener('click', function() {
      resetActivePaymentMethod();
      pixOption.classList.add('active');
      creditCardForm.style.display = 'none';
    });

    // Máscaras para os campos de formulário
    const cardNumberInput = document.getElementById('card-number');
    if (cardNumberInput) {
      cardNumberInput.addEventListener('input', function(e) {
        let value = e.target.value.replace(/\D/g, '');
        if (value.length > 16) value = value.slice(0, 16);

        // Adicionar espaços a cada 4 dígitos
        value = value.replace(/(\d{4})(?=\d)/g, '$1 ');
        e.target.value = value;
      });
    }

    const cardExpiryInput = document.getElementById('card-expiry');
    if (cardExpiryInput) {
      cardExpiryInput.addEventListener('input', function(e) {
        let value = e.target.value.replace(/\D/g, '');
        if (value.length > 4) value = value.slice(0, 4);

        // Formato MM/AA
        if (value.length > 2) {
          value = value.slice(0, 2) + '/' + value.slice(2);
        }

        e.target.value = value;
      });
    }

    const cpfInput = document.getElementById('cpf');
    if (cpfInput) {
      cpfInput.addEventListener('input', function(e) {
        let value = e.target.value.replace(/\D/g, '');
        if (value.length > 11) value = value.slice(0, 11);

        // Formato 000.000.000-00
        if (value.length > 9) {
          value = value.slice(0, 3) + '.' + value.slice(3, 6) + '.' + value.slice(6, 9) + '-' + value.slice(9);
        } else if (value.length > 6) {
          value = value.slice(0, 3) + '.' + value.slice(3, 6) + '.' + value.slice(6);
        } else if (value.length > 3) {
          value = value.slice(0, 3) + '.' + value.slice(3);
        }

        e.target.value = value;
      });
    }

    const telefoneInput = document.getElementById('telefone');
    if (telefoneInput) {
      telefoneInput.addEventListener('input', function(e) {
        let value = e.target.value.replace(/\D/g, '');
        if (value.length > 11) value = value.slice(0, 11);

        // Formato (00) 00000-0000
        if (value.length > 6) {
          value = '(' + value.slice(0, 2) + ') ' + value.slice(2, 7) + '-' + value.slice(7);
        } else if (value.length > 2) {
          value = '(' + value.slice(0, 2) + ') ' + value.slice(2);
        }

        e.target.value = value;
      });
    }

    const cvvInput = document.getElementById('card-cvv');
    if (cvvInput) {
      cvvInput.addEventListener('input', function(e) {
        let value = e.target.value.replace(/\D/g, '');
        if (value.length > 4) value = value.slice(0, 4);
        e.target.value = value;
      });
    }
  });
</script>