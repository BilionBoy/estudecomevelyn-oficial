<style>
  :root {
    --primary: #e42278;
    --primary-dark: #c41864;
    --primary-light: #f5d3dd;
    --primary-lighter: #fdf0f5;
    --secondary: #1a1a2e;
    --text-dark: #333333;
    --text-light: #8a8a8a;
    --background: #f9f9f9;
    --white: #ffffff;
    --border-radius: 16px;
    --box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    --transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Poppins', sans-serif;
    background-color: var(--background);
    color: var(--text-dark);
    line-height: 1.6;
    background-image: linear-gradient(135deg, #f9f9f9 0%, #f5f5f5 100%);
    min-height: 100vh;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 15px;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -15px;
  }

  .col-md-8, .col-md-4 {
    padding: 0 15px;
    width: 100%;
  }

  @media (min-width: 768px) {
    .col-md-8 {
      width: 66.66%;
    }
    .col-md-4 {
      width: 33.33%;
    }
  }
  /* Checkout Container */
  .checkout-container {
    padding: 40px 0 60px;
  }

  .checkout-title {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: 2.8rem;
    color: var(--secondary);
    margin-bottom: 40px;
    text-align: center;
    position: relative;
  }

  .checkout-title:after {
    content: '';
    position: absolute;
    bottom: -15px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 4px;
    background: linear-gradient(90deg, var(--primary-light), var(--primary), var(--primary-light));
    border-radius: 4px;
  }

  /* Checkout Sections */
  .checkout-section {
    background-color: var(--white);
    border-radius: var(--border-radius);
    box-shadow: var(--box-shadow);
    padding: 35px;
    margin-bottom: 30px;
    transition: var(--transition);
    border: 1px solid rgba(0, 0, 0, 0.03);
    position: relative;
    overflow: hidden;
  }

  .checkout-section:before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 5px;
    background: linear-gradient(90deg, var(--primary-light), var(--primary), var(--primary-light));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s ease;
  }

  .checkout-section:hover {
    box-shadow: 0 15px 35px rgba(228, 34, 120, 0.1);
    transform: translateY(-5px);
  }

  .checkout-section:hover:before {
    transform: scaleX(1);
  }

  .section-title {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: 1.6rem;
    color: var(--secondary);
    margin-bottom: 25px;
    padding-bottom: 15px;
    border-bottom: 2px solid var(--primary-light);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .section-title i {
    color: var(--primary);
    font-size: 1.8rem;
    background-color: var(--primary-lighter);
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  /* Form Styles */
  .form-group {
    margin-bottom: 25px;
    position: relative;
  }

  .form-label {
    display: block;
    margin-bottom: 10px;
    font-weight: 500;
    color: var(--secondary);
    font-size: 0.95rem;
    transition: var(--transition);
  }

  .form-control {
    width: 100%;
    padding: 14px 18px;
    border: 2px solid #e8e8e8;
    border-radius: 12px;
    font-family: 'Poppins', sans-serif;
    font-size: 1rem;
    transition: var(--transition);
    background-color: #fafafa;
  }

  .form-control:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 4px rgba(228, 34, 120, 0.1);
    outline: none;
    background-color: white;
  }

  .form-control::placeholder {
    color: #bbb;
    font-weight: 300;
  }

  .form-row {
    display: flex;
    gap: 20px;
    margin-bottom: 0;
  }

  .form-row .form-group {
    flex: 1;
  }

  /* Payment Methods */
  .payment-methods {
    display: flex;
    gap: 15px;
    margin-bottom: 30px;
  }

  .payment-method {
    flex: 1;
    min-width: 120px;
    padding: 20px 15px;
    border: 2px solid #e8e8e8;
    border-radius: var(--border-radius);
    text-align: center;
    cursor: pointer;
    transition: var(--transition);
    position: relative;
    overflow: hidden;
    background-color: #fafafa;
  }

  .payment-method:hover {
    border-color: var(--primary-light);
    background-color: var(--primary-lighter);
    transform: translateY(-3px);
  }

  .payment-method.active {
    border-color: var(--primary);
    background-color: var(--primary-lighter);
    box-shadow: 0 5px 15px rgba(228, 34, 120, 0.15);
  }

  .payment-method.active:before {
    content: '\f00c';
    font-family: 'Font Awesome 6 Free';
    font-weight: 900;
    position: absolute;
    top: -10px;
    right: -10px;
    background-color: var(--primary);
    color: white;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
  }

  .payment-method-icon {
    font-size: 2.5rem;
    margin-bottom: 12px;
    color: var(--text-light);
    transition: var(--transition);
    background-color: white;
    width: 70px;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    margin: 0 auto 15px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
  }

  .payment-method.active .payment-method-icon {
    color: var(--primary);
    transform: scale(1.1);
    box-shadow: 0 8px 20px rgba(228, 34, 120, 0.15);
  }

  .payment-method-name {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text-dark);
  }

  .payment-method.active .payment-method-name {
    color: var(--primary);
    font-weight: 600;
  }

  .payment-method-description {
    font-size: 0.85rem;
    color: var(--text-light);
    margin-top: 5px;
    line-height: 1.4;
  }

  .payment-logos {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 25px;
    flex-wrap: wrap;
    padding: 15px;
    background-color: #fafafa;
    border-radius: 12px;
  }

  .payment-logo {
    width: 50px;
    height: 30px;
    object-fit: contain;
    opacity: 0.7;
    transition: var(--transition);
    filter: grayscale(30%);
  }

  .payment-logo:hover {
    opacity: 1;
    transform: scale(1.1);
    filter: grayscale(0%);
  }

  /* Credit Card Form */
  .credit-card-container {
    position: relative;
    margin-bottom: 30px;
  }

  .credit-card {
    background: linear-gradient(135deg, #434343 0%, #000000 100%);
    border-radius: 16px;
    padding: 25px;
    color: white;
    margin-bottom: 30px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    position: relative;
    overflow: hidden;
    height: 200px;
    transition: var(--transition);
  }

  .credit-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
  }

  .credit-card:before {
    content: '';
    position: absolute;
    top: -50px;
    right: -50px;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    z-index: 1;
  }

  .credit-card:after {
    content: '';
    position: absolute;
    bottom: -80px;
    left: -80px;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    z-index: 1;
  }

  .card-chip {
    width: 50px;
    height: 40px;
    background: linear-gradient(135deg, #dca54c 0%, #ffd700 100%);
    border-radius: 8px;
    margin-bottom: 20px;
    position: relative;
    z-index: 2;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }

  .card-chip:before {
    content: '';
    position: absolute;
    top: 10px;
    left: 10px;
    width: 30px;
    height: 20px;
    background: rgba(0, 0, 0, 0.1);
    border-radius: 4px;
  }

  .card-number {
    font-size: 1.4rem;
    letter-spacing: 2px;
    margin-bottom: 15px;
    position: relative;
    z-index: 2;
    font-family: 'Courier New', monospace;
  }

  .card-holder {
    font-size: 0.9rem;
    text-transform: uppercase;
    position: relative;
    z-index: 2;
    opacity: 0.8;
  }

  .card-holder-name {
    font-size: 1.1rem;
    font-weight: 500;
    margin-top: 5px;
    position: relative;
    z-index: 2;
  }

  .card-expiry {
    position: absolute;
    bottom: 25px;
    right: 25px;
    text-align: right;
    z-index: 2;
  }

  .card-expiry-label {
    font-size: 0.8rem;
    opacity: 0.8;
  }

  .card-expiry-date {
    font-size: 1.1rem;
    font-weight: 500;
  }

  .card-brand {
    position: absolute;
    top: 25px;
    right: 25px;
    font-size: 2rem;
    z-index: 2;
  }

  /* Order Summary */
  .order-item {
    display: flex;
    align-items: center;
    padding: 20px 0;
    border-bottom: 1px solid #f0f0f0;
    transition: var(--transition);
  }

  .order-item:hover {
    background-color: var(--primary-lighter);
    transform: translateX(5px);
    border-radius: 12px;
    padding-left: 10px;
    padding-right: 10px;
  }

  .order-item:last-child {
    border-bottom: none;
  }

  .order-item-image {
    width: 80px;
    height: 80px;
    border-radius: 12px;
    overflow: hidden;
    margin-right: 20px;
    background-color: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    transition: var(--transition);
  }

  .order-item:hover .order-item-image {
    transform: scale(1.05);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  }

  .order-item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition);
  }

  .order-item:hover .order-item-image img {
    transform: scale(1.1);
  }

  .no-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-light);
    font-size: 2rem;
    background-color: #f0f0f0;
  }

  .order-item-details {
    flex: 1;
  }

  .order-item-title {
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--secondary);
    margin-bottom: 8px;
    transition: var(--transition);
  }

  .order-item:hover .order-item-title {
    color: var(--primary);
  }

  .order-item-info {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    font-size: 0.9rem;
    color: var(--text-light);
  }

  .order-item-info span {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .order-item-info i {
    color: var(--primary);
    font-size: 0.8rem;
  }

  .order-item-price {
    font-weight: 600;
    color: var(--primary);
    font-size: 1.2rem;
    text-align: right;
    transition: var(--transition);
  }

  .order-item:hover .order-item-price {
    transform: scale(1.1);
  }

  .order-item-remove {
    color: var(--text-light);
    font-size: 0.85rem;
    text-decoration: none;
    margin-top: 8px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: var(--transition);
    padding: 5px 10px;
    border-radius: 20px;
    background-color: #f5f5f5;
  }

  .order-item-remove:hover {
    color: white;
    background-color: #ff4d6d;
  }

  .order-summary {
    background-color: #fafafa;
    padding: 20px;
    border-radius: 12px;
    margin-top: 20px;
  }

  .order-summary-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
    font-size: 1rem;
    padding: 5px 0;
  }

  .order-summary-label {
    color: var(--text-light);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .order-summary-label i {
    color: var(--primary);
    font-size: 0.9rem;
  }

  .order-summary-value {
    font-weight: 500;
    color: var(--text-dark);
  }

  .order-summary-value.discount {
    color: #2ecc71;
  }

  .order-summary-value.free {
    color: #2ecc71;
    font-weight: 600;
  }

  .order-total {
    display: flex;
    justify-content: space-between;
    padding: 15px 0;
    border-top: 2px dashed var(--primary-light);
    margin-top: 15px;
    background-color: var(--primary-lighter);
    border-radius: 8px;
    padding: 15px;
  }

  .order-total-label {
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--secondary);
  }

  .order-total-value {
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--primary);
    text-shadow: 0 1px 2px rgba(228, 34, 120, 0.2);
  }

  /* Coupon */
  .coupon-container {
    margin-top: 25px;
    position: relative;
  }

  .input-group {
    display: flex;
    position: relative;
  }

  .input-group .form-control {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-right: none;
    padding-right: 20px;
  }

  .input-group-btn {
    background-color: var(--primary);
    color: white;
    border: none;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    padding: 0 25px;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .input-group-btn:hover {
    background-color: var(--primary-dark);
    box-shadow: 0 5px 15px rgba(228, 34, 120, 0.2);
  }

  .input-group-btn i {
    font-size: 0.9rem;
  }

  /* Checkout Button */
  .btn-checkout {
    display: block;
    width: 100%;
    padding: 18px;
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    color: white;
    border: none;
    border-radius: var(--border-radius);
    font-family: 'Poppins', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
    text-align: center;
    text-decoration: none;
    margin-top: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    box-shadow: 0 8px 25px rgba(228, 34, 120, 0.25);
    position: relative;
    overflow: hidden;
  }

  .btn-checkout:before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: 0.5s;
  }

  .btn-checkout:hover {
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 100%);
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(228, 34, 120, 0.3);
  }

  .btn-checkout:hover:before {
    left: 100%;
  }

  .btn-checkout i {
    font-size: 1.2rem;
  }

  /* Security Info */
  .security-info {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    margin-top: 25px;
    color: var(--text-light);
    font-size: 0.9rem;
    flex-wrap: wrap;
  }

  .security-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 15px;
    background-color: #f5f5f5;
    border-radius: 50px;
    transition: var(--transition);
    border: 1px solid transparent;
  }

  .security-badge:hover {
    background-color: white;
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    border-color: var(--primary-light);
  }

  .security-badge i {
    color: var(--primary);
    font-size: 1rem;
  }

  /* Installment Options */
  .installment-options {
    margin-top: 20px;
  }

  .installment-title {
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 15px;
    color: var(--secondary);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .installment-title i {
    color: var(--primary);
  }

  .installment-cards {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .installment-card {
    flex: 1;
    min-width: 120px;
    padding: 12px;
    border: 1px solid #e8e8e8;
    border-radius: 10px;
    text-align: center;
    cursor: pointer;
    transition: var(--transition);
    background-color: #fafafa;
  }

  .installment-card:hover {
    border-color: var(--primary-light);
    background-color: white;
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
  }

  .installment-card.active {
    border-color: var(--primary);
    background-color: var(--primary-lighter);
  }

  .installment-value {
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--primary);
    margin-bottom: 5px;
  }

  .installment-info {
    font-size: 0.8rem;
    color: var(--text-light);
  }

  /* Boleto and PIX Forms */
  .boleto-form, .pix-form {
    display: none;
    margin-top: 20px;
  }

  .payment-info-box {
    background-color: var(--primary-lighter);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 20px;
    border: 1px dashed var(--primary-light);
  }

  .payment-info-title {
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--primary);
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .payment-info-text {
    color: var(--text-dark);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .payment-info-text strong {
    color: var(--primary);
  }

  .payment-qrcode {
    width: 200px;
    height: 200px;
    margin: 20px auto;
    background-color: white;
    padding: 15px;
    border-radius: 12px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    position: relative;
  }

  .payment-qrcode img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .payment-qrcode:before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: repeating-linear-gradient(
      45deg,
      #f5f5f5,
      #f5f5f5 10px,
      #e8e8e8 10px,
      #e8e8e8 20px
    );
    z-index: -1;
    border-radius: 12px;
  }

  .payment-qrcode:after {
    content: 'QR Code PIX';
    position: absolute;
    bottom: -30px;
    left: 0;
    right: 0;
    text-align: center;
    font-weight: 500;
    color: var(--primary);
    font-size: 0.9rem;
  }

  .copy-code-btn {
    background-color: var(--primary);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 15px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 15px auto;
    transition: var(--transition);
  }

  .copy-code-btn:hover {
    background-color: var(--primary-dark);
    transform: translateY(-2px);
  }

  /* Responsive */
  @media (max-width: 767px) {
    .form-row {
      flex-direction: column;
      gap: 0;
    }

    .payment-methods {
      flex-direction: column;
    }

    .payment-method {
      padding: 15px;
    }

    .checkout-section {
      padding: 25px;
    }

    .order-item-info {
      flex-direction: column;
      gap: 5px;
    }

    .installment-cards {
      flex-direction: column;
    }

    .credit-card {
      height: 180px;
    }

    .card-number {
      font-size: 1.2rem;
    }
  }

  /* Animations */
  @keyframes pulse {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
    100% {
      transform: scale(1);
    }
  }

  .pulse {
    animation: pulse 2s infinite;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fade-in {
    animation: fadeIn 0.5s ease-out forwards;
  }
</style>
<!-- Main Content -->
<main class="container checkout-container">
  <h1 class="checkout-title">Finalizar Compra</h1>
  <div class="row">
    <!-- Left Column - Forms -->
    <div class="col-md-8">
      <!-- Personal Information -->
      <section class="checkout-section fade-in" style="animation-delay: 0.1s;">
        <h2 class="section-title">
          <i class="fas fa-user-circle"></i>
          Informações Pessoais
        </h2>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="nome">Nome Completo</label>
            <input type="text" class="form-control" id="nome" placeholder="Digite seu nome completo">
          </div>
          <div class="form-group">
            <label class="form-label" for="email">E-mail</label>
            <input type="email" class="form-control" id="email" placeholder="Digite seu e-mail">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="cpf">CPF</label>
            <input type="text" class="form-control" id="cpf" placeholder="000.000.000-00">
          </div>
          <div class="form-group">
            <label class="form-label" for="telefone">Telefone</label>
            <input type="tel" class="form-control" id="telefone" placeholder="(00) 00000-0000">
          </div>
        </div>
      </section>
      <!-- Payment Method -->
      <section class="checkout-section fade-in" style="animation-delay: 0.2s;">
        <h2 class="section-title">
          <i class="fas fa-credit-card"></i>
          Método de Pagamento
        </h2>
        <div class="payment-methods">
          <div class="payment-method active" id="credit-card-option">
            <div class="payment-method-icon">
              <i class="fas fa-credit-card"></i>
            </div>
            <div class="payment-method-name">Cartão de Crédito</div>
            <div class="payment-method-description">Pague em até 12x</div>
          </div>
          <div class="payment-method" id="boleto-option">
            <div class="payment-method-icon">
              <i class="fas fa-barcode"></i>
            </div>
            <div class="payment-method-name">Boleto</div>
            <div class="payment-method-description">Vencimento em 3 dias</div>
          </div>
          <div class="payment-method" id="pix-option">
            <div class="payment-method-icon">
              <i class="fas fa-qrcode"></i>
            </div>
            <div class="payment-method-name">PIX</div>
            <div class="payment-method-description">Aprovação imediata</div>
          </div>
        </div>
        <!-- Credit Card Form -->
        <div id="credit-card-form">
          <div class="credit-card-container">
            <div class="credit-card">
              <div class="card-chip"></div>
              <div class="card-number" id="card-number-display">•••• •••• •••• ••••</div>
              <div class="card-holder">Nome no cartão</div>
              <div class="card-holder-name" id="card-name-display">Seu Nome</div>
              <div class="card-expiry">
                <div class="card-expiry-label">Validade</div>
                <div class="card-expiry-date" id="card-expiry-display">MM/AA</div>
              </div>
              <div class="card-brand">
                <i class="fab fa-cc-visa"></i>
              </div>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="card-number">Número do Cartão</label>
            <input type="text" class="form-control" id="card-number" placeholder="0000 0000 0000 0000">
          </div>
          <div class="form-group">
            <label class="form-label" for="card-name">Nome no Cartão</label>
            <input type="text" class="form-control" id="card-name" placeholder="Nome como está no cartão">
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="card-expiry">Data de Validade</label>
              <input type="text" class="form-control" id="card-expiry" placeholder="MM/AA">
            </div>
            <div class="form-group">
              <label class="form-label" for="card-cvv">CVV</label>
              <input type="text" class="form-control" id="card-cvv" placeholder="123">
            </div>
          </div>
          <div class="installment-options">
            <div class="installment-title">
              <i class="fas fa-calendar-alt"></i>
              Opções de Parcelamento
            </div>
            <div class="installment-cards">
              <div class="installment-card active" data-value="1">
                <div class="installment-value">1x R$ 101,00</div>
                <div class="installment-info">à vista sem juros</div>
              </div>
              <div class="installment-card" data-value="2">
                <div class="installment-value">2x R$ 50,50</div>
                <div class="installment-info">sem juros</div>
              </div>
              <div class="installment-card" data-value="3">
                <div class="installment-value">3x R$ 33,67</div>
                <div class="installment-info">sem juros</div>
              </div>
              <div class="installment-card" data-value="6">
                <div class="installment-value">6x R$ 16,83</div>
                <div class="installment-info">sem juros</div>
              </div>
              <div class="installment-card" data-value="12">
                <div class="installment-value">12x R$ 9,42</div>
                <div class="installment-info">com juros</div>
              </div>
            </div>
          </div>
        </div>
        <!-- Boleto Form -->
        <div id="boleto-form" class="boleto-form">
          <div class="payment-info-box">
            <div class="payment-info-title">
              <i class="fas fa-info-circle"></i>
              Informações do Boleto
            </div>
            <div class="payment-info-text">
              <p>Ao finalizar sua compra, você receberá o boleto bancário por e-mail. O boleto também estará disponível na área "Meus Pedidos" da sua conta.</p>
              <p><strong>Importante:</strong> O boleto tem vencimento em 3 dias úteis. Após o pagamento, a confirmação pode levar até 3 dias úteis.</p>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="cpf-boleto">CPF/CNPJ do Pagador</label>
            <input type="text" class="form-control" id="cpf-boleto" placeholder="Digite o CPF ou CNPJ do pagador">
          </div>
        </div>
        <!-- PIX Form -->
        <div id="pix-form" class="pix-form">
          <div class="payment-info-box">
            <div class="payment-info-title">
              <i class="fas fa-info-circle"></i>
              Informações do PIX
            </div>
            <div class="payment-info-text">
              <p>Ao finalizar sua compra, você receberá um QR Code PIX para pagamento. O pagamento via PIX é processado instantaneamente.</p>
              <p><strong>Importante:</strong> O QR Code tem validade de 30 minutos. Após esse período, será necessário gerar um novo.</p>
            </div>
          </div>
          <div class="payment-qrcode">
            <img src="https://upload.wikimedia.org/wikipedia/commons/d/d0/QR_code_for_mobile_English_Wikipedia.svg" alt="QR Code PIX">
          </div>
          <div style="text-align: center;">
            <div style="background-color: #f5f5f5; padding: 10px; border-radius: 8px; display: inline-block; margin-bottom: 15px;">
              <code style="font-size: 0.9rem; color: var(--secondary);">7a8b9c1d2e3f4g5h6i7j8k9l0m1n2o3p4q5r6s7t8u9v0</code>
            </div>
            <button class="copy-code-btn">
              <i class="fas fa-copy"></i>
              Copiar código PIX
            </button>
          </div>
        </div>
        <!-- Payment Logos -->
        <div class="payment-logos">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/visa/visa-original.svg" alt="Visa" class="payment-logo">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mastercard/mastercard-original.svg" alt="Mastercard" class="payment-logo">
          <img src="https://logodownload.org/wp-content/uploads/2020/02/pix-bc-logo-1-1.png" alt="PIX" class="payment-logo" style="width: 35px;">
          <img src="https://logodownload.org/wp-content/uploads/2017/04/boleto-logo.png" alt="Boleto" class="payment-logo" style="width: 50px;">
          <img src="https://logodownload.org/wp-content/uploads/2017/11/elo-logo-5.png" alt="Elo" class="payment-logo">
          <img src="https://logodownload.org/wp-content/uploads/2017/10/hipercard-logo-1.png" alt="Hipercard" class="payment-logo">
          <img src="https://logodownload.org/wp-content/uploads/2020/11/american-express-logo-0.png" alt="American Express" class="payment-logo">
        </div>
      </section>
    </div>
    <!-- Right Column - Order Summary -->
    <div class="col-md-4">
      <section class="checkout-section fade-in" style="animation-delay: 0.3s;">
        <h2 class="section-title">
          <i class="fas fa-shopping-cart"></i>
          Resumo do Pedido
        </h2>
        <!-- Order Items -->
        <div class="order-items">
          <% if carrinho.present? && carrinho.i_itens_carrinhos.any? %>
            <% carrinho.i_itens_carrinhos.each do |item| %>
              <div class="order-item">
                <div class="order-item-image">
                  <% if item.i_produto.respond_to?(:imagem) && item.i_produto.imagem.attached? %>
                    <%= image_tag url_for(item.i_produto.imagem), alt: item.i_produto.nome %>
                  <% else %>
                    <div class="no-image-placeholder">
                      <i class="fas fa-book"></i>
                    </div>
                  <% end %>
                </div>
                <div class="order-item-details">
                  <h4 class="order-item-title"><%= item.i_produto.nome %></h4>
                  <div class="order-item-info">
                    <span><i class="fas fa-layer-group"></i> Quantidade: <%= item.quantidade %></span>
                    <span><i class="fas fa-tag"></i> Preço: <%= number_to_currency(item.preco_unitario, unit: "R$") %></span>
                  </div>
                  <a href="#" class="order-item-remove">
                    <i class="fas fa-times"></i> Remover
                  </a>
                </div>
                <div class="order-item-price">
                  <%= number_to_currency(item.subtotal, unit: "R$") %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
        <!-- Order Summary -->
        <div class="order-summary">
          <div class="order-summary-row">
            <span class="order-summary-label"><i class="fas fa-receipt"></i> Subtotal</span>
            <span class="order-summary-value"><%= number_to_currency(carrinho.total, unit: "R$") %></span>
          </div>
          <div class="order-summary-row">
            <span class="order-summary-label"><i class="fas fa-truck"></i> Frete</span>
            <span class="order-summary-value free">Grátis</span>
          </div>
          <div class="order-summary-row">
            <span class="order-summary-label"><i class="fas fa-percent"></i> Desconto</span>
            <span class="order-summary-value">R$ 0,00</span>
          </div>
          <div class="order-total">
            <span class="order-total-label">Total</span>
            <span class="order-total-value pulse"><%= number_to_currency(carrinho.total, unit: "R$") %></span>
          </div>
        </div>
        <!-- Coupon -->
        <div class="coupon-container">
          <label class="form-label" for="coupon">Cupom de Desconto</label>
          <div class="input-group">
            <input type="text" class="form-control" id="coupon" placeholder="Digite seu cupom">
            <button class="input-group-btn">
              <i class="fas fa-check"></i>
              Aplicar
            </button>
          </div>
        </div>
        <!-- Checkout Button -->
        <button type="submit" class="btn-checkout">
          <i class="fas fa-lock"></i>
          Finalizar Pagamento
        </button>
        <!-- Security Info -->
        <div class="security-info">
          <div class="security-badge">
            <i class="fas fa-shield-alt"></i>
            <span>Compra 100% Segura</span>
          </div>
          <div class="security-badge">
            <i class="fas fa-lock"></i>
            <span>Pagamento Protegido</span>
          </div>
          <div class="security-badge">
            <i class="fas fa-truck"></i>
            <span>Entrega Garantida</span>
          </div>
        </div>
      </section>
    </div>
  </div>
</main>
<script>
  // JavaScript para alternar entre métodos de pagamento
  document.addEventListener('DOMContentLoaded', function() {
    const creditCardOption = document.getElementById('credit-card-option');
    const boletoOption = document.getElementById('boleto-option');
    const pixOption = document.getElementById('pix-option');
    const creditCardForm = document.getElementById('credit-card-form');
    const boletoForm = document.getElementById('boleto-form');
    const pixForm = document.getElementById('pix-form');

    // Função para remover a classe 'active' de todos os métodos
    function resetActivePaymentMethod() {
      creditCardOption.classList.remove('active');
      boletoOption.classList.remove('active');
      pixOption.classList.remove('active');
    }

    // Adicionar event listeners para os métodos de pagamento
    creditCardOption.addEventListener('click', function() {
      resetActivePaymentMethod();
      creditCardOption.classList.add('active');
      creditCardForm.style.display = 'block';
      boletoForm.style.display = 'none';
      pixForm.style.display = 'none';
    });

    boletoOption.addEventListener('click', function() {
      resetActivePaymentMethod();
      boletoOption.classList.add('active');
      creditCardForm.style.display = 'none';
      boletoForm.style.display = 'block';
      pixForm.style.display = 'none';
    });

    pixOption.addEventListener('click', function() {
      resetActivePaymentMethod();
      pixOption.classList.add('active');
      creditCardForm.style.display = 'none';
      boletoForm.style.display = 'none';
      pixForm.style.display = 'block';
    });

    // Máscaras para os campos de formulário
    const cardNumberInput = document.getElementById('card-number');
    const cardNumberDisplay = document.getElementById('card-number-display');

    if (cardNumberInput) {
      cardNumberInput.addEventListener('input', function(e) {
        let value = e.target.value.replace(/\D/g, '');
        if (value.length > 16) value = value.slice(0, 16);

        // Adicionar espaços a cada 4 dígitos
        value = value.replace(/(\d{4})(?=\d)/g, '$1 ');
        e.target.value = value;

        // Atualizar o display do cartão
        if (value) {
          cardNumberDisplay.textContent = value;
        } else {
          cardNumberDisplay.textContent = '•••• •••• •••• ••••';
        }

        // Detectar bandeira do cartão
        const cardBrand = document.querySelector('.card-brand i');
        const firstDigit = value.charAt(0);

        if (firstDigit === '4') {
          cardBrand.className = 'fab fa-cc-visa';
        } else if (firstDigit === '5') {
          cardBrand.className = 'fab fa-cc-mastercard';
        } else if (firstDigit === '3') {
          cardBrand.className = 'fab fa-cc-amex';
        } else if (firstDigit === '6') {
          cardBrand.className = 'fab fa-cc-discover';
        } else {
          cardBrand.className = 'fab fa-credit-card';
        }
      });
    }

    const cardNameInput = document.getElementById('card-name');
    const cardNameDisplay = document.getElementById('card-name-display');

    if (cardNameInput) {
      cardNameInput.addEventListener('input', function(e) {
        const value = e.target.value;

        if (value) {
          cardNameDisplay.textContent = value.toUpperCase();
        } else {
          cardNameDisplay.textContent = 'Seu Nome';
        }
      });
    }

    const cardExpiryInput = document.getElementById('card-expiry');
    const cardExpiryDisplay = document.getElementById('card-expiry-display');

    if (cardExpiryInput) {
      cardExpiryInput.addEventListener('input', function(e) {
        let value = e.target.value.replace(/\D/g, '');
        if (value.length > 4) value = value.slice(0, 4);

        // Formato MM/AA
        if (value.length > 2) {
          value = value.slice(0, 2) + '/' + value.slice(2);
        }

        e.target.value = value;

        if (value) {
          cardExpiryDisplay.textContent = value;
        } else {
          cardExpiryDisplay.textContent = 'MM/AA';
        }
      });
    }

    const cpfInput = document.getElementById('cpf');
    if (cpfInput) {
      cpfInput.addEventListener('input', function(e) {
        let value = e.target.value.replace(/\D/g, '');
        if (value.length > 11) value = value.slice(0, 11);

        // Formato 000.000.000-00
        if (value.length > 9) {
          value = value.slice(0, 3) + '.' + value.slice(3, 6) + '.' + value.slice(6, 9) + '-' + value.slice(9);
        } else if (value.length > 6) {
          value = value.slice(0, 3) + '.' + value.slice(3, 6) + '.' + value.slice(6);
        } else if (value.length > 3) {
          value = value.slice(0, 3) + '.' + value.slice(3);
        }

        e.target.value = value;
      });
    }

    const telefoneInput = document.getElementById('telefone');
    if (telefoneInput) {
      telefoneInput.addEventListener('input', function(e) {
        let value = e.target.value.replace(/\D/g, '');
        if (value.length > 11) value = value.slice(0, 11);

        // Formato (00) 00000-0000
        if (value.length > 6) {
          value = '(' + value.slice(0, 2) + ') ' + value.slice(2, 7) + '-' + value.slice(7);
        } else if (value.length > 2) {
          value = '(' + value.slice(0, 2) + ') ' + value.slice(2);
        }

        e.target.value = value;
      });
    }

    const cvvInput = document.getElementById('card-cvv');
    if (cvvInput) {
      cvvInput.addEventListener('input', function(e) {
        let value = e.target.value.replace(/\D/g, '');
        if (value.length > 4) value = value.slice(0, 4);
        e.target.value = value;
      });
    }

    // Opções de parcelamento
    const installmentCards = document.querySelectorAll('.installment-card');
    installmentCards.forEach(card => {
      card.addEventListener('click', function() {
        installmentCards.forEach(c => c.classList.remove('active'));
        this.classList.add('active');
      });
    });

    // Botão de copiar código PIX
    const copyCodeBtn = document.querySelector('.copy-code-btn');
    if (copyCodeBtn) {
      copyCodeBtn.addEventListener('click', function() {
        const pixCode = document.querySelector('code').textContent;
        navigator.clipboard.writeText(pixCode).then(() => {
          this.innerHTML = '<i class="fas fa-check"></i> Código copiado!';
          setTimeout(() => {
            this.innerHTML = '<i class="fas fa-copy"></i> Copiar código PIX';
          }, 2000);
        });
      });
    }
  });
</script>