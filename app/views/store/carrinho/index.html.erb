<h1>Carrinho de Compras</h1>
<% if session[:carrinho].empty? %>
  <p>Seu carrinho está vazio.</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>Produto</th>
        <th>Preço</th>
        <th>Quantidade</th>
        <th>Total</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% session[:carrinho].each do |produto_id, quantidade| %>
        <% produto = IProduto.find(produto_id) %>
        <tr>
          <td><%= produto.nome %></td>
          <td><%= number_to_currency(produto.preco) %></td>
          <td><%= quantidade %></td>
          <td><%= number_to_currency(produto.preco * quantidade) %></td>
          <td>
            <%= link_to 'Remover', store_carrinho_remove_path(produto_id: produto.id), method: :delete %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p><strong>Total: <%= number_to_currency(total_carrinho) %></strong></p>
  <%= link_to 'Limpar Carrinho', store_carrinho_clear_path, method: :delete, class: 'btn btn-danger' %>
  <%= button_to "Finalizar Compra", finalizar_compra_store_carrinho_path, method: :post, class: "btn btn-primary" %>
<% end %>
