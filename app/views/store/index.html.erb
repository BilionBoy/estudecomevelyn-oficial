<% content_for :title, "Estude com Evelyn – Home" %>
<% content_for :description, "Explore nossa seleção de cursos, papelaria e artigos educativos para turbinar seus estudos!" %>
<div class="div d-none d-lg-block">
  <%= image_tag "/layout/assets/img/BannerOficial.png", class: "group-2-7-img", style: "width: 100%;" %>
</div>
<!-- HOME SECTION -->
<section id="home" class="hero">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6 hero-content">
        <h1 class="hero-title">
          Transforme suas letras em verdadeiras obras de arte
        </h1>
        <p class="hero-subtitle lead" style="color: #0d111a">
          Recursos, cursos e inspiração para artistas de lettering que
          desejam elevar sua arte ao próximo nível.
        </p>
        <div class="d-flex gap-3">
          <%= link_to "Ver Papelaria Digital", root_path, class: "btn btn-primary btn-lg rounded-pill" %>
          <%= link_to "Explorar Cursos",       root_path, class: "btn btn-light btn-lg rounded-pill" %>
        </div>
      </div>
      <div class="col-lg-6 hero-img mt-5 mt-lg-0">
        <%= image_tag "https://direitocomevellyn.com/wp-content/uploads/2024/06/prod-1.png", alt: "Lettering Art", class: "img-fluid" %>
      </div>
    </div>
  </div>
</section>
<!-- Seção de Produtos em Destaque -->
<section class="py-5">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="fw-bold">Papelaria Digital em Destaque</h2>
      <p class="text-muted">Recursos digitais premium para elevar sua arte</p>
    </div>
    <%= render partial: 'store/shared/produtos_cards', locals: { produtos: @i_produtos } %>
    <div class="text-center mt-5">
      <%= link_to "Ver Todos os manuais",papelaria_path, class: "btn btn-primary rounded-pill px-4 py-2" %>
    </div>
  </div>
</section>
<style></style>