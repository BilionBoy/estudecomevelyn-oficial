<h1>Finalizar Compra</h1>
<%= form_with model: @pedido, url: store_checkout_path, method: :post do |f| %>
  <div>
    <h2>Resumo do Pedido</h2>
    <%= render partial: "store/carrinho/resumo", locals: { carrinho: @carrinho } %>
  </div>
  <div>
    <%= f.submit "Finalizar Pedido" %>
  </div>
<% end %>
