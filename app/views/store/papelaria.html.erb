<% content_for :title, "Papelaria – Estude com Evelyn" %>
<% content_for :description, "Cadernos, canetas, planners e muito mais! Tudo para deixar seus estudos organizados e inspiradores." %>
<style>
  h1, h2, h3, h4, h5, h6, .display-4, .display-5 {
    font-family: "Playfair Display", serif;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }


  p {
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .filter-card {
  cursor: pointer;
  }
</style>
<!-- Page Header -->
<section class="page-header">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 page-header-content">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">
              Eve Notes
            </li>
          </ol>
        </nav>
        <h1 class="page-title">Papelaria Digital para Lettering</h1>
        <p class="lead">
          Recursos digitais premium para elevar sua arte ao próximo nível
        </p>
      </div>
    </div>
  </div>
</section>
<section class="py-5">
  <div class="container">
    <div class="row">
      <% @g_categorias.each do |categoria| %>
        <div class="col-lg-3 col-md-6">
          <div class="category-card position-relative overflow-hidden filter-card" data-categoria="<%= categoria.slug %>">
            <% if categoria.foto_categoria.attached? %>
              <%= image_tag url_for(categoria.foto_categoria), class: "category-img", alt: categoria.nome %>
            <% else %>
              <%= image_tag "https://via.placeholder.com/800x500", class: "category-img", alt: "Imagem não disponível" %>
            <% end %>
            <div class="category-overlay"></div>
            <div class="category-content">
              <h3 class="category-title"><%= categoria.nome %></h3>
              <p class="category-count"><%= categoria.i_produtos.count %> produtos</p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
<!-- Filtros -->
<section class="py-2">
  <div class="container">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
      <div>
        <h5 class="mb-3 mb-md-0">Filtrar por:</h5>
      </div>
      <div class="d-flex flex-wrap">
        <%= button_tag 'Todos', class: 'filter-btn active', data: { categoria: 'todos' } %>
        <% # Exclui as categorias do segmento "Cursos" %>
        <% GCategoria.where.not(id: Segmento.find_by(nome: "Cursos")&.g_categorias&.pluck(:id)).order(:nome).each do |g_categoria| %>
          <%= button_tag g_categoria.nome, class: 'filter-btn', data: { categoria: g_categoria.slug } %>
        <% end %>
      </div>
    </div>
    <% if @produtos.present? %>
      <%= render partial: 'store/shared/produtos_cards', locals: { produtos: @produtos } %>
    <% else %>
      <p class="text-gray-600">Nenhum produto disponível no momento.</p>
    <% end %>
  </div>
</section>
<%= render 'shared/notice' %>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const filterBtns = document.querySelectorAll(".filter-btn");
    const filterCards = document.querySelectorAll(".filter-card");
    const produtoCards = document.querySelectorAll(".produto-card"); // ou .product-card dependendo do seu HTML

    function aplicarFiltro(slug) {
      produtoCards.forEach(card => {
        const cardSlug = card.dataset.categoria;
        if (slug === "todos" || cardSlug === slug) {
          card.style.display = "";
        } else {
          card.style.display = "none";
        }
      });

      // Atualiza botões
      filterBtns.forEach(btn => btn.classList.remove("active"));
      filterBtns.forEach(btn => {
        if (btn.dataset.categoria === slug) {
          btn.classList.add("active");
        }
      });
    }

    // Clique nos botões
    filterBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        const slug = btn.dataset.categoria;
        aplicarFiltro(slug);
      });
    });

    // Clique nas imagens (cards)
    filterCards.forEach(card => {
      card.addEventListener("click", () => {
        const slug = card.dataset.categoria;
        aplicarFiltro(slug);
      });
    });
  });
</script>