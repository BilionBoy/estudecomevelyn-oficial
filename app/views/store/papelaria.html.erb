<style>
  h1, h2, h3, h4, h5, h6, .display-4, .display-5 {
    font-family: "Playfair Display", serif;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }


  p {
    margin-top: 0;
    margin-bottom: 1rem;
  }
</style>
<!-- Page Header -->
<section class="page-header">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 page-header-content">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">
              Eve Notes
            </li>
          </ol>
        </nav>
        <h1 class="page-title">Papelaria Digital para Lettering</h1>
        <p class="lead">
          Recursos digitais premium para elevar sua arte ao próximo nível
        </p>
      </div>
    </div>
  </div>
</section>
<section class="py-5">
  <div class="container">
    <div class="row">
      <% @g_categorias.each do |categoria| %>
        <div class="col-lg-3 col-md-6">
          <div class="category-card position-relative overflow-hidden">
            <% if categoria.foto_categoria.attached? %>
              <%= image_tag categoria.foto_categoria.variant(resize_to_fill: [800, 500]), class: "category-img", alt: categoria.nome %>
            <% else %>
              <%= image_tag "https://via.placeholder.com/800x500", class: "category-img", alt: "Imagem não disponível" %>
            <% end %>
            <div class="category-overlay"></div>
            <div class="category-content">
              <h3 class="category-title"><%= categoria.nome %></h3>
              <p class="category-count"><%= categoria.i_produtos.count %> produtos</p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
<!-- Filtros -->
<section class="py-2">
  <div class="container">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
      <div>
        <h5 class="mb-3 mb-md-0">Filtrar por:</h5>
      </div>
      <div class="d-flex flex-wrap">
        <%= button_tag 'Todos', class: 'filter-btn active', data: { categoria: 'todos' } %>
        <% GCategoria.order(:nome).each do |g_categoria| %>
          <%= button_tag g_categoria.nome, class: 'filter-btn', data: { categoria: g_categoria.slug } %>
        <% end %>
      </div>
    </div>
    <% if @produtos.present? %>
      <%= render partial: 'store/shared/produtos_cards', locals: { produtos: @produtos } %>
    <% else %>
      <p class="text-gray-600">Nenhum produto disponível no momento.</p>
    <% end %>
  </div>
</section>
<%= render 'shared/notice' %>
