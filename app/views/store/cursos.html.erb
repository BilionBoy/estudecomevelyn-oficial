<% content_for :title, "Cursos Online – Estude com Evelyn" %>
<% content_for :description, "Cursos para quem quer aprender de forma prática, rápida e com leveza. Acesse agora!" %>
<style>
  h1, h2, h3, h4, h5, h6, .display-4, .display-5 {
    font-family: "Playfair Display", serif;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }


  p {
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .filter-card {
  cursor: pointer;
  }
</style>
<!-- Page Header -->
<section class="page-header">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 page-header-content">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">
              Cursos
            </li>
          </ol>
        </nav>
        <h1 class="page-title">Cursos Digital para Lettering</h1>
        <p class="lead">
          Aprenda Em Comunidade, Compartilhando Ideias E Projetos Com Criativos Do Mundo Todo. Cursos 100% Online.        </p>
      </div>
    </div>
  </div>
</section>
<section class="py-5">
  <div class="container">
    <div class="row">
      <% @g_categorias.each do |categoria| %>
        <div class="col-lg-3 col-md-6">
          <div class="category-card position-relative overflow-hidden filter-card" data-categoria="<%= categoria.slug %>">
            <% if categoria.foto_categoria.attached? %>
              <%= image_tag categoria.foto_categoria.variant(resize_to_fill: [800, 500]), class: "category-img", alt: categoria.nome %>
            <% else %>
              <%= image_tag "https://via.placeholder.com/800x500", class: "category-img", alt: "Imagem não disponível" %>
            <% end %>
            <div class="category-overlay"></div>
            <div class="category-content">
              <h3 class="category-title"><%= categoria.nome %></h3>
              <p class="category-count"><%= categoria.i_cursos.count %> produtos</p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>