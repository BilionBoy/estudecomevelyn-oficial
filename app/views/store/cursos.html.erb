<% content_for :title, "Cursos Online – Estude com Evelyn" %>
<% content_for :description, "Cursos para quem quer aprender de forma prática, rápida e com leveza. Acesse agora!" %>
<style>
  h1, h2, h3, h4, h5, h6, .display-4, .display-5 {
    font-family: "Playfair Display", serif;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  p {
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .filter-card {
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .filter-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
  }

  .filter-btn {
    background: white;
    border: 2px solid #e5e7eb;
    color: #6b7280;
    padding: 12px 24px;
    margin: 0 8px 8px 0;
    border-radius: 25px;
    font-weight: 600;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .filter-btn:hover {
    border-color: #ec4899;
    color: #ec4899;
    transform: translateY(-2px);
  }

  .filter-btn.active {
    border-color: #ec4899;
    color: white;
    box-shadow: 0 4px 15px rgba(236, 72, 153, 0.3);
  }
</style>
<!-- Page Header -->
<section class="page-header">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 page-header-content">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="<%= root_path %>">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Cursos</li>
          </ol>
        </nav>
        <h1 class="page-title">Cursos Digital para Lettering</h1>
        <p class="lead">
          Aprenda Em Comunidade, Compartilhando Ideias E Projetos Com Criativos Do Mundo Todo. Cursos 100% Online.
        </p>
      </div>
    </div>
  </div>
</section>
<!-- Categorias em Cards -->
<section class="py-5">
  <div class="container">
    <div class="row">
      <% @g_categorias.each do |categoria| %>
        <div class="col-lg-3 col-md-6 mb-4">
          <div class="category-card position-relative overflow-hidden filter-card" 
               data-categoria="<%= categoria.slug %>"
               style="height: 200px; border-radius: 20px; cursor: pointer;">
            <% if categoria.foto_categoria.attached? %>
              <%= image_tag categoria.foto_categoria.variant(resize_to_fill: [400, 200]), 
                  class: "category-img w-100 h-100", 
                  style: "object-fit: cover;", 
                  alt: categoria.nome %>
            <% else %>
              <div class="w-100 h-100" ></div>
            <% end %>
            <div class="category-overlay position-absolute top-0 start-0 w-100 h-100" 
                 style="background: rgba(0,0,0,0.4);"></div>
            <div class="category-content position-absolute bottom-0 start-0 p-4 text-white">
              <h3 class="category-title h5 fw-bold mb-1"><%= categoria.nome %></h3>
              <p class="category-count small mb-0 opacity-75">
                <%= categoria.i_cursos.count %>
                <%= categoria.i_cursos.count == 1 ? 'curso' : 'cursos' %>
              </p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
<!-- Filtros e Cursos -->
<section class="py-2">
  <div class="container">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-5">
      <div>
        <h5 class="mb-3 mb-md-0 fw-bold">Filtrar por:</h5>
      </div>
      <div class="d-flex flex-wrap">
        <%= button_tag 'Todos', class: 'filter-btn active', data: { categoria: 'todos' } %>
        <% segmento_cursos = Segmento.find_by(nome: "Cursos") %>
        <% if segmento_cursos.present? %>
          <% segmento_cursos.g_categorias.order(:nome).each do |g_categoria| %>
            <%= button_tag g_categoria.nome, class: 'filter-btn', data: { categoria: g_categoria.slug } %>
          <% end %>
        <% end %>
      </div>
    </div>
    <% if @cursos.present? %>
      <%= render partial: 'store/shared/cursos_cards', locals: { cursos: @cursos } %>
    <% else %>
      <div class="text-center py-5">
        <i class="fas fa-graduation-cap fa-3x text-muted mb-3"></i>
        <h4 class="text-muted">Nenhum curso disponível no momento</h4>
        <p class="text-muted">Novos cursos em breve! Fique ligado.</p>
      </div>
    <% end %>
  </div>
</section>
<!-- Modal de Detalhes do Curso -->
<% @cursos.each do |curso| %>
  <%= render 'store/shared/modal_cursos', curso: curso %>
<% end %><%= render 'shared/notice' %>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Filtros de categoria
    document.querySelectorAll('.filter-btn').forEach(button => {
      button.addEventListener('click', function() {
        // Remover classe active de todos os botões
        document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
        // Adicionar classe active ao botão clicado
        this.classList.add('active');

        const categoria = this.dataset.categoria;

        // Filtrar cursos
        document.querySelectorAll('.curso-item').forEach(item => {
          if (categoria === 'todos' || item.dataset.categoria === categoria) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });

    // Filtros de categoria nos cards
    document.querySelectorAll('.filter-card').forEach(card => {
      card.addEventListener('click', function() {
        const categoria = this.dataset.categoria;

        // Atualizar botões de filtro
        document.querySelectorAll('.filter-btn').forEach(btn => {
          btn.classList.remove('active');
          if (btn.dataset.categoria === categoria) {
            btn.classList.add('active');
          }
        });

        // Filtrar cursos
        document.querySelectorAll('.curso-item').forEach(item => {
          if (item.dataset.categoria === categoria) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  });
</script>
