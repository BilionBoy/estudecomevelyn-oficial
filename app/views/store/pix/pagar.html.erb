<h1>Pagamento via Pix</h1>
<p>Valor: <%= number_to_currency(@payment["value"].to_f, unit: "R$", separator: ",", delimiter: ".") %></p>
<p>Vencimento: <%= @payment["dueDate"] %></p>
<% if @payment["pixQrCode"] && @payment["pixQrCode"]["encodedImage"].present? %>
  <h2>QR Code</h2>
  <img src="data:image/png;base64,<%= @payment["pixQrCode"]["encodedImage"] %>" alt="QR Code Pix" />
<% else %>
  <p>QR Code não disponível.</p>
<% end %>
<p>
  <a href="<%= @payment["invoiceUrl"] %>" target="_blank" rel="noopener">Abrir boleto / fatura</a>
</p>
