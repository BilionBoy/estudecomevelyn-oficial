<div id="<%= dom_id g_usuario %>">
  <p>
    <strong>Nome:</strong>
    <%= g_usuario.nome %>
  </p>

  <p>
    <strong>Email:</strong>
    <%= g_usuario.email %>
  </p>

  <p>
    <strong>Password digest:</strong>
    <%= g_usuario.password_digest %>
  </p>

  <p>
    <strong>Tipo usuario:</strong>
    <%= g_usuario.tipo_usuario_id %>
  </p>

</div>
