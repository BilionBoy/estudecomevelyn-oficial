<div class="container">
  <%= render "shared/notice" %>
  <div class="card border-0 shadow shadow-sm">
    <div class="card-header border-0 d-flex justify-content-between">
      <span class="fs-4">Visualizar G Usuario</span>
    </div>
    <div class="card-body">
      <div id="<%= dom_id @g_usuario %>">
          <p>
            <strong>Nome:</strong>
            <%= @g_usuario.nome %>
          </p>
          <p>
            <strong>Email:</strong>
            <%= @g_usuario.email %>
          </p>
          <p>
            <strong>Password Digest:</strong>
            <%= @g_usuario.password_digest %>
          </p>
          <p>
            <strong>Tipo Usuario:</strong>
            <%= @g_usuario.tipo_usuario %>
          </p>
      </div>
    </div>
    <div class="card-footer border-0 d-flex justify-content-between">
      <div>
        <%= link_to edit_g_usuario_path(@g_usuario), class: "btn btn-primary" do %>
        <i class="bi bi-pencil-square"></i> Editar
        <% end %>
        <%= link_to "Voltar", g_usuarios_path, class: "btn btn-secondary" %>
      </div>
      <%= button_to "Deletar", @g_usuario, method: :delete, class: "btn btn-outline-danger border-0" %>
    </div>
  </div>
</div>
