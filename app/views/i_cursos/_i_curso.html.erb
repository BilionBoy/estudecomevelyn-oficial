<div id="<%= dom_id i_curso %>">
  <p>
    <strong>Nome:</strong>
    <%= i_curso.nome %>
  </p>

  <p>
    <strong>Slug:</strong>
    <%= i_curso.slug %>
  </p>

  <p>
    <strong>Descricao:</strong>
    <%= i_curso.descricao %>
  </p>

  <p>
    <strong>Preco:</strong>
    <%= i_curso.preco %>
  </p>

  <p>
    <strong>G categoria:</strong>
    <%= i_curso.g_categoria_id %>
  </p>

  <p>
    <strong>Url externa:</strong>
    <%= i_curso.url_externa %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= i_curso.status %>
  </p>

  <p>
    <strong>Created by:</strong>
    <%= i_curso.created_by %>
  </p>

  <p>
    <strong>Updated by:</strong>
    <%= i_curso.updated_by %>
  </p>

</div>
