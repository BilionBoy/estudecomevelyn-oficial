<%= render "shared/context_nav", title: t("activerecord.models.#{ICurso.model_name.i18n_key}.other") do  %>
  <span class="breadcrumb-item"><%= link_to t("activerecord.models.#{ICurso.model_name.i18n_key}.other"), i_cursos_path, class: "text-dark" %></span>
  <span class="breadcrumb-item active"><%= t("helpers.submit.#{params[:action]}") %></span>
<% end %>
<%= simple_form_for(@i_curso) do |f| %>
  <div class="card">
    <div class="card-header">
      <h5 class="my-0">
        <%= @i_curso.new_record? ? "Incluir " : "Editar " %><%= t("activerecord.models.#{ICurso.model_name.i18n_key}.one") %>
      </h5>
    </div>
    <div class="card-body">
      <%= f.error_notification %>
      <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>
      <div class="row">
        <div class="col-7">
          <%= f.input :nome, input_html: { class: "capitalize"}, placeholder: "Nome"  %>
        </div>
        <div class="col-5">
          <%= f.input :slug, input_html: { class: "capitalize"}, placeholder: "Slug"  %>
        </div>
        <div class="col-12">
          <%= f.input :descricao, input_html: { class: "capitalize"}, placeholder: "Descricao"  %>
        </div>
        <div class="col-5">
          <%= f.input :preco, input_html: { class: "capitalize"}, placeholder: "Preco"  %>
        </div>
        <div class="col-7">
          <%= f.input :g_categoria_id, collection: GCategoria.all.map { |c| [c.nome, c.id] }, prompt: "Selecione a categoria", input_html: { class: "capitalize" } %>
        </div>
        <div class="col-12">
          <%= f.input :url_externa, input_html: { class: "capitalize"}, placeholder: "Insira o Link de Venda"  %>
        </div>
        <div class="col-5">
          <%= f.input :status, collection: [['Ativo', 'ativo'], ['Inativo', 'inativo']], prompt: "Selecione o status", input_html: { class: "capitalize" } %>
        </div>
        <div class="form-group">
          <%= f.label :imagem_capa, "Foto da Categoria" %>
          <% if f.object.persisted? && f.object.imagem_capa.attached? %>
            <p>Imagem de Capa já cadastrada. Você pode atualizar abaixo, se necessário.</p>
          <% else %>
            <%= f.file_field :imagem_capa, class: "form-control" %>
          <% end %>
        </div>
        <div class="col-7">
          <% if f.object.imagem_capa.attached? %>
            <%= image_tag url_for(f.object.imagem_capa), alt: "Imagem de Capa", class: "img-thumbnail mb-2" %>
          <% else %>
            <p>Não há imagem cadastrada.</p>
          <% end %>
        </div>
      </div>
    </div>
    <div class="card-footer">
      <%= btn_submit(f) %>
      <%= link_to "Voltar", i_cursos_path, class: "btn btn-light" %>
    </div>
  </div>
<% end %>