<div class="div d-none d-lg-block">
  <%= image_tag "/layout/assets/img/NovoBanner.png", class: "group-2-7-img" %>
</div>
<!-- HOME SECTION -->
<section id="home" class="hero">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6 hero-content">
        <h1 class="hero-title">
          Transforme suas letras em verdadeiras obras de arte
        </h1>
        <p class="hero-subtitle lead" style="color: #0d111a">
          Recursos, cursos e inspiração para artistas de lettering que
          desejam elevar sua arte ao próximo nível.
        </p>
        <div class="d-flex gap-3">
          <%= link_to "Ver Papelaria Digital", root_path, class: "btn btn-primary btn-lg rounded-pill" %>
          <%= link_to "Explorar Cursos", root_path, class: "btn btn-light btn-lg rounded-pill" %>
        </div>
      </div>
      <div class="col-lg-6 hero-img mt-5 mt-lg-0">
        <%= image_tag "https://direitocomevellyn.com/wp-content/uploads/2024/06/prod-1.png", alt: "Lettering Art", class: "img-fluid" %>
      </div>
    </div>
  </div>
</section>
<section id="hero" class="d-flex align-items-center">
  <div class="hero-background">
    <%= image_tag "https://direitocomevellyn.com/wp-content/uploads/2024/06/banner2.jpg", 
      alt: "Background", class: "hero-bg-image" %>
  </div>
  <div class="container position-relative">
    <div class="row align-items-center">
      <div class="col-lg-6 text-center text-lg-start" data-aos="fade-right" data-aos-duration="1200">
        <h1 class="hero-title-img">
          O Manual Completo de
          <span class="highlight">Lettering digital</span> ao seu alcance
        </h1>
        <p class="hero-subtitle d-none d-lg-block">
          Crie anotações bonitas e criativas em todos os dispositivos
        </p>
        <div class="d-flex flex-wrap justify-content-center justify-content-lg-start mt-4 mb-5">
          <%= link_to "Quero meu manual agora", "https://chk.eduzz.com/2397008", class: "btn-hero-primary" %>
        </div>
      </div>
    </div>
  </div>
</section>