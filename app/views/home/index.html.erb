<div class="div d-none d-lg-block">
  <%= image_tag "/layout/assets/img/NovoBanner.png", class: "group-2-7-img", style: "width: 100%;" %>
</div>
<!-- HOME SECTION -->
<section id="home" class="hero">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6 hero-content">
        <h1 class="hero-title">
          Transforme suas letras em verdadeiras obras de arte
        </h1>
        <p class="hero-subtitle lead" style="color: #0d111a">
          Recursos, cursos e inspiração para artistas de lettering que
          desejam elevar sua arte ao próximo nível.
        </p>
        <div class="d-flex gap-3">
          <%= link_to "Ver Papelaria Digital", root_path, class: "btn btn-primary btn-lg rounded-pill" %>
          <%= link_to "Explorar Cursos", root_path, class: "btn btn-light btn-lg rounded-pill" %>
        </div>
      </div>
      <div class="col-lg-6 hero-img mt-5 mt-lg-0">
        <%= image_tag "https://direitocomevellyn.com/wp-content/uploads/2024/06/prod-1.png", alt: "Lettering Art", class: "img-fluid" %>
      </div>
    </div>
  </div>
</section>
<section class="py-5 bg-light">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="fw-bold">Destaques da Papelaria Digital</h2>
      <p class="text-muted">Confira alguns dos nossos produtos disponíveis</p>
    </div>
    <div class="mb-4 d-flex flex-wrap justify-content-center gap-2">
      <% @g_categorias.each do |categoria| %>
        <%= link_to categoria.nome, root_path(categoria: categoria.slug), class: "btn btn-outline-primary rounded-pill px-3 py-1" %>
      <% end %>
    </div>
    <div class="row">
      <% @i_produtos.each do |produto| %>
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="card h-100 shadow-sm">
            <% if produto.imagem.attached? %>
              <%= image_tag url_for(produto.imagem), class: "card-img-top", alt: produto.nome %>
            <% else %>
              <p class="text-center text-muted">Sem imagem</p>
            <% end %>
            <div class="card-body d-flex flex-column">
              <h5 class="card-title"><%= produto.nome %></h5>
              <p class="card-text text-muted"><%= truncate(produto.descricao, length: 100) %></p>
              <p class="fw-bold mb-2">R$ <%= number_to_currency(produto.preco, unit: "", separator: ",", delimiter: ".") %></p>
              <%= link_to "Ver Produto", i_produto_path(produto), class: "btn btn-outline-primary mt-auto rounded-pill" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="card-footer">
      <%= pagy_bootstrap_nav(@pagy, link_extra: 'class="btn btn-outline-secondary btn-sm mx-1"').html_safe %>
    </div>
  </div>
</section>
