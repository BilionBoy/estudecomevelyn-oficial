<style>
  h1, h2, h3, h4, h5, h6, .display-4, .display-5 {
    font-family: "Playfair Display", serif;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .lead {
    font-family: "Montserrat", sans-serif;
    font-weight: 300;
    letter-spacing: 0.01em;
    line-height: 1.6;
    font-size: 1.25rem;
  }

  p {
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .breadcrumb {
    background: transparent;
    padding: 0;
    margin-bottom: 0;
  }

  .breadcrumb-item a {
    color: var(--primary);
    text-decoration: none;
  }

  .breadcrumb-item.active {
    color: var(--gray);
  }


  @media (max-width: 768px) {
    .card-title {
        font-size: 1.25rem;
    }
  }
  .card-title {
    font-family: "Cormorant Garamond", serif;
    font-weight: 600;
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
    color: var(--dark);
    line-height: 1.3;}
</style>
<!-- Page Header -->
<section class="page-header">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 page-header-content">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">
              Papelaria Digital
            </li>
          </ol>
        </nav>
        <h1 class="page-title">Papelaria Digital para Lettering</h1>
        <p class="lead">
          Recursos digitais premium para elevar sua arte ao próximo nível
        </p>
      </div>
    </div>
  </div>
</section>
<!-- Filters Section -->
<section class="py-2">
  <div class="container">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
      <div>
        <h5 class="mb-3 mb-md-0">Filtrar por:</h5>
      </div>
      <div class="d-flex flex-wrap">
        <%= button_tag 'Todos', class: 'filter-btn active', data: { categoria: 'todos' } %>
        <% GCategoria.order(:nome).each do |g_categoria| %>
          <%= button_tag g_categoria.nome, class: 'filter-btn', data: { categoria: g_categoria.slug } %>
        <% end %>
      </div>
    </div>
    <% if @produtos.present? %>
      <%= render partial: 'shared/home/produtos_cards', locals: { produtos: @produtos } %>
    <% else %>
      <p class="text-gray-600">Nenhum produto disponível no momento.</p>
    <% end %>
  </div>
</section>
<%= render 'shared/notice' %>
