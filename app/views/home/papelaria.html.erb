<!-- app/views/home/papelaria.html.erb -->
<div class="container py-4">
  <h1 class="text-2xl font-bold mb-4 text-center">Papelaria Digital</h1>
  <%= render 'shared/notice' %>
  <% if @produtos.present? %>
    <%= render partial: 'shared/home/produtos_cards', locals: { produtos: @produtos } %>
  <% else %>
    <p class="text-gray-600">Nenhum produto disponível no momento.</p>
  <% end %>
</div>
