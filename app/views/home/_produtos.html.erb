<!-- Produtos SECTION -->
<section class="py-5">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="fw-bold">Destaques da Papelaria Digital</h2>
      <p class="text-muted">Confira alguns dos nossos produtos disponíveis</p>
    </div>
    <%= render partial: 'shared/home/produtos_cards', locals: { produtos: @i_produtos } %>
    <% if @pagy.present? %>
      <div class="mt-5">
        <%= pagy_bootstrap_nav(@pagy, link_extra: 'class="page-link"').html_safe %>
      </div>
    <% end %>
  </div>
</section>