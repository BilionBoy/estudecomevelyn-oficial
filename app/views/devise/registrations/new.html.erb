<h2>Sign up</h2>
<%= simple_form_for(resource, as: resource_name, url: user_registration_path) do |f| %>
  <%= f.error_notification %>
  <div class="form-inputs">
    <!-- Nome -->
    <div class="field">
      <%= f.label :nome, class: 'form-label' %>
      <%= f.text_field :nome, autofocus: true, autocomplete: "name", class: 'form-control' %>
    </div>
    <!-- Email -->
    <div class="field">
      <%= f.label :email, class: 'form-label' %>
      <%= f.email_field :email, required: true, autofocus: true, input_html: { autocomplete: "email" }, class: 'form-control' %>
    </div>
    <!-- Senha -->
    <div class="field">
      <%= f.label :password, class: 'form-label' %>
      <%= f.password_field :password, required: true, hint: "#{@minimum_password_length} characters minimum", input_html: { autocomplete: "new-password" }, class: 'form-control' %>
    </div>
    <!-- Confirmação de Senha -->
    <div class="field">
      <%= f.label :password_confirmation, class: 'form-label' %>
      <%= f.password_field :password_confirmation, required: true, input_html: { autocomplete: "new-password" }, class: 'form-control' %>
    </div>
    <!-- Tipo de Usuário -->
    <div class="field">
      <%= f.label :g_tipo_usuario_id, "Tipo de Usuário", class: 'form-label' %>
      <%= f.select :g_tipo_usuario_id, GTipoUsuario.all.collect { |t| [t.nome, t.id] }, include_blank: "Selecione um tipo", class: 'form-control' %>
    </div>
  </div>
  <div class="form-actions">
    <%= f.button :submit, "Sign up", class: 'btn btn-primary' %>
  </div>
<% end %>
<% if @user.errors.any? %>
  <div id="error_explanation" class="alert alert-danger">
    <h2><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h2>
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<%= render "devise/shared/links" %>
