<%= render "shared/context_nav", title: t("activerecord.models.#{IPromocaoProduto.model_name.i18n_key}.other") do  %>
  <span class="breadcrumb-item"><%= link_to t("activerecord.models.#{IPromocaoProduto.model_name.i18n_key}.other"), i_promocao_produtos_path, class: "text-dark" %></span>
  <span class="breadcrumb-item active"><%= t("helpers.submit.#{params[:action]}") %></span>
<% end %>
<%= simple_form_for(@i_promocao_produto) do |f| %>
  <div class="card">
    <div class="card-header">
      <h5 class="my-0">
        <%= @i_promocao_produto.new_record? ? "Incluir " : "Editar " %><%= t("activerecord.models.#{IPromocaoProduto.model_name.i18n_key}.one") %>
      </h5>
    </div>
    <div class="card-body">
      <%= f.error_notification %>
      <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>
      <div class="row">
        <div class="col-12">
          <%= f.association :i_promocao, input_html: { class: "capitalize"}, placeholder: "I promocao"  %>
        </div>
        <div class="col-12">
          <%= f.association :i_produto, input_html: { class: "capitalize"}, placeholder: "I produto"  %>
        </div>
        <div class="col-12">
          <%= f.input :preco_promocional, input_html: { class: "capitalize"}, placeholder: "Preco promocional"  %>
        </div>
      </div>
    </div>
    <div class="card-footer">
      <%= btn_submit(f) %>
      <%= link_to "Voltar", i_promocao_produtos_path, class: "btn btn-light" %>
    </div>
  </div>
<% end %>