<div class="container">
  <%= render "shared/notice" %>
  <div class="card border-0 shadow shadow-sm">
    <div class="card-header border-0 d-flex justify-content-between">
      <span class="fs-4">Visualizar I Promocao Produto</span>
    </div>
    <div class="card-body">
      <div id="<%= dom_id @i_promocao_produto %>">
          <p>
            <strong>I Promocao:</strong>
            <%= @i_promocao_produto.i_promocao %>
          </p>
          <p>
            <strong>I Produto:</strong>
            <%= @i_promocao_produto.i_produto %>
          </p>
          <p>
            <strong>Preco Promocional:</strong>
            <%= @i_promocao_produto.preco_promocional %>
          </p>
      </div>
    </div>
    <div class="card-footer border-0 d-flex justify-content-between">
      <div>
        <%= link_to edit_i_promocao_produto_path(@i_promocao_produto), class: "btn btn-primary" do %>
        <i class="bi bi-pencil-square"></i> Editar
        <% end %>
        <%= link_to "Voltar", i_promocao_produtos_path, class: "btn btn-secondary" %>
      </div>
      <%= button_to "Deletar", @i_promocao_produto, method: :delete, class: "btn btn-outline-danger border-0" %>
    </div>
  </div>
</div>
