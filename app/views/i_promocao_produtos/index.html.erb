<%= render "shared/context_nav", title: t("activerecord.models.IPromocaoProduto.other"), new_path: new_i_promocao_produto_path do %>
  <span class="breadcrumb-item active"><%= t("activerecord.models.IPromocaoProduto.other") %></span>
<% end %>
<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h2 class="card-title"><%= t("activerecord.models.ipromocaoproduto.other") %></h2>
    <div>
      <%= link_to new_i_promocao_produto_path, class: "btn btn-sm btn-primary" do %>
        <i class="lucide-plus-circle"></i> Incluir
      <% end %>
    </div>
  </div>
  <!-- Filtro com Ransack -->
  <div class="card-body">
    <%= search_form_for @q, url: i_promocao_produtos_path, method: :get, html: { class: "mb-3" } do |f| %>
      <div class="row">
        <div class="col-md-4">
          <%= f.label :i_promocao_nome_cont, t("activerecord.attributes.i_promocao_produto.i_promocao") %>
          <%= f.search_field :i_promocao_nome_cont, class: "form-control", placeholder: t("activerecord.attributes.i_promocao_produto.i_promocao") %>
        </div>
        <div class="col-md-4">
          <%= f.label :i_produto_cont, t("activerecord.attributes.i_promocao_produto.i_produto") %>
          <%= f.search_field :i_produto_nome_cont, class: "form-control", placeholder: t("activerecord.attributes.i_promocao_produto.i_produto") %>
        </div>
        <div class="col-md-4 d-flex align-items-end">
          <%= f.submit "Filtrar", class: "btn btn-sm btn-primary me-2" %>
          <%= link_to "Limpar", i_promocao_produtos_path, class: "btn btn-sm btn-secondary" if params[:q] %>
        </div>
      </div>
    <% end %>
  </div>
  <!-- Tabela -->
  <div class="card-body">
    <div class="table-responsive" style="height: 400px; overflow-y: auto;">
      <table class="table table-sm table-bordered table-striped">
        <thead>
          <tr>
            <th class="text-center">Ações</th>
            <th><%= sort_link(@q, :i_promocao, t("activerecord.attributes.i_promocao_produto.i_promocao")) %></th>
            <th><%= sort_link(@q, :i_produto, t("activerecord.attributes.i_promocao_produto.i_produto")) %></th>
            <th><%= sort_link(@q, :preco_promocional, t("activerecord.attributes.i_promocao_produto.preco_promocional")) %></th>
          </tr>
        </thead>
        <tbody>
          <% @i_promocao_produtos.each do |i_promocao_produto| %>
            <tr>
              <td class="text-center">
                <div class="dropdown">
                  <a href="#" class="dropdown-toggle text-body" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ph-gear"></i>
                  </a>
                  <div class="dropdown-menu">
                    <div class="dropdown-header">Opções</div>
                    <%= link_to edit_i_promocao_produto_path(i_promocao_produto), class: "dropdown-item" do %>
                      <i class="ph-pen me-2"></i> Editar
                    <% end %>
                    <%= button_to i_promocao_produto_path(i_promocao_produto), method: :delete, data: { confirm: "Tem certeza que deseja excluir?" }, class: "dropdown-item text-danger" do %>
                      <i class="ph-trash-simple me-2"></i> Excluir
                    <% end %>
                  </div>
                </div>
              </td>
              <td><%= i_promocao_produto.i_promocao %></td>
              <td><%= i_promocao_produto.i_produto %></td>
              <td><%= i_promocao_produto.preco_promocional %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <!-- Paginação -->
  <div class="card-footer">
    <%= pagy_bootstrap_nav(@pagy, link_extra: 'class="btn btn-outline-secondary btn-sm mx-1"').html_safe %>
  </div>
</div>
<!-- Estilo -->
<style>
  .table-responsive {
    height: 400px;
    overflow-y: auto;
  }
</style>
