<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h2 class="card-title">Usuários</h2>
    <div>
      <%= link_to new_g_tipo_usuario_path, class: "btn btn-sm btn-primary" do %>
        <i class="lucide-user-plus"></i> Incluir Novo Cliente
      <% end %>
    </div>
  </div>
  <!-- Filtro Ransack -->
  <div class="card-body">
    <%= search_form_for @q, url: g_tipo_usuarios_path, method: :get, html: { class: "mb-3" } do |f| %>
      <div class="row">
        <div class="col-md-4">
          <%= f.label :nome_cont, "Nome" %>
          <%= f.search_field :nome_cont, class: "form-control", placeholder: "Pesquisar por nome" %>
        </div>
        <div class="col-md-4">
          <%= f.label :descricao_cont, "Descrição" %>
          <%= f.search_field :descricao_cont, class: "form-control", placeholder: "Pesquisar por descrição" %>
        </div>
        <div class="col-md-4 d-flex align-items-end">
          <%= f.submit "Filtrar", class: "btn btn-sm btn-primary" %>
        </div>
      </div>
    <% end %>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Nome</th>
            <th>Descrição</th>
            <th>Data de Criação</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @g_tipo_usuarios.each do |g_tipo_usuario| %>
            <tr>
              <td><%= g_tipo_usuario.nome %></td>
              <td><%= g_tipo_usuario.descricao %></td>
              <td><%= l(g_tipo_usuario.created_at, format: :short) %></td>
              <td>
                <div class="dropdown">
                  <a href="#" class="dropdown-toggle d-flex align-items-center text-body" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ph-gear"></i> <!-- Ícone de engrenagem -->
                  </a>
                  <div class="dropdown-menu">
                    <div class="dropdown-header">Opções</div>
                    <%= link_to edit_g_tipo_usuario_path(g_tipo_usuario), class: "dropdown-item d-flex align-items-center" do %>
                      <i class="ph-pen me-2"></i> <!-- Ícone de edição -->
                      <span>Editar</span>
                    <% end %>
                    <%= button_to g_tipo_usuario_path(g_tipo_usuario), method: :delete, data: { confirm: "Tem certeza que deseja excluir este tipo de usuário?" }, class: "dropdown-item d-flex align-items-center", form: { class: 'd-inline' } do %>
                      <i class="ph-trash-simple me-2"></i> <!-- Ícone de lixeira -->
                      <span>Excluir</span>
                    <% end %>
                  </div>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <!-- Paginação -->
    <div class="card-footer">
      <%= pagy_bootstrap_nav(@pagy, link_extra: 'class="btn btn-outline-secondary btn-sm mx-1"').html_safe %>
    </div>
  </div>
</div>
<style>
  /* Definindo altura fixa para a tabela */
  .table-responsive {
  height: 400px;
  overflow-y: auto;  /* Adiciona rolagem se o conteúdo exceder o tamanho */
  }


</style>