<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h2 class="card-title">Usuários</h2>
    <div>
      <%= link_to new_g_tipo_usuario_path, class: "btn btn-sm btn-primary" do %>
        <i class="lucide-user-plus"></i> Incluir Novo Cliente
      <% end %>
    </div>
  </div>
  <!-- Filtro Ransack -->
  <div class="card-body">
    <%= search_form_for @q, url: g_tipo_usuarios_path, method: :get, html: { class: "mb-3" } do |f| %>
      <div class="row">
        <div class="col-md-4">
          <%= f.label :nome_cont, "Nome" %>
          <%= f.search_field :nome_cont, class: "form-control", placeholder: "Pesquisar por nome" %>
        </div>
        <div class="col-md-4">
          <%= f.label :descricao_cont, "Descrição" %>
          <%= f.search_field :descricao_cont, class: "form-control", placeholder: "Pesquisar por descrição" %>
        </div>
        <div class="col-md-4 d-flex align-items-end">
          <%= f.submit "Filtrar", class: "btn btn-sm btn-primary" %>
        </div>
      </div>
    <% end %>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Nome</th>
            <th>Descrição</th>
            <th>Data de Criação</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @g_tipo_usuarios.each do |g_tipo_usuario| %>
            <tr>
              <td><%= g_tipo_usuario.nome %></td>
              <td><%= g_tipo_usuario.descricao %></td>
              <td><%= l(g_tipo_usuario.created_at, format: :short) %></td>
              <td>
                <div class="d-flex gap-1">
                  <%= link_to edit_g_tipo_usuario_path(g_tipo_usuario), class: "btn btn-sm btn-icon btn-secondary", aria: { label: "Editar" } do %>
                    <i class="lucide-edit"></i>
                  <% end %>
                  <%= link_to g_tipo_usuario_path(g_tipo_usuario), class: "btn btn-sm btn-icon btn-secondary", aria: { label: "Ver detalhes" } do %>
                    <i class="lucide-eye"></i>
                  <% end %>
                  <%= link_to g_tipo_usuario_path(g_tipo_usuario), method: :delete, data: { confirm: "Tem certeza?" }, class: "btn btn-sm btn-icon btn-danger", aria: { label: "Excluir" } do %>
                    <i class="lucide-trash-2"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <!-- Paginação -->
    <div class="card-footer">
      <%= pagy_bootstrap_nav(@pagy, link_extra: 'class="btn btn-outline-secondary btn-sm mx-1"').html_safe %>
    </div>
  </div>
</div>
