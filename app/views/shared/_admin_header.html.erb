<header class="header">
  <button class="mobile-toggle" id="mobile-toggle" aria-label="Abrir menu">
    <i class="lucide-menu"></i>
  </button>
  <h1 class="header-title"><%= title %></h1>
  <%= form_with url: request.path, method: :get, local: true, class: "header-search" do |form| %>
    <%= form.text_field :busca, 
        placeholder: "Buscar #{title.downcase}...", 
        class: "header-search-input",
        value: params[:busca] %>
    <i class="lucide-search header-search-icon"></i>
  <% end %>
  <div class="header-actions">
    <button class="header-action-btn" aria-label="Notificações">
      <i class="lucide-bell"></i>
      <span class="header-action-badge">3</span>
    </button>
    <button class="header-action-btn" aria-label="Mensagens">
      <i class="lucide-mail"></i>
      <span class="header-action-badge">5</span>
    </button>
    <div class="header-user">
      <img
          src="https://ui-avatars.com/api/?name=<%= current_user.nome %>&background=6366f1&color=fff"
          alt="<%= current_user.nome %>"
          class="header-user-avatar"
        />
      <div class="header-user-info">
          <div class="header-user-name"><%= current_user.nome %></div>
        <div class="header-user-role"><%= current_user.g_tipo_usuario.nome %></div>
      </div>
    </div>
  </div>
</header>