<!-- Sidebar -->
<aside class="sidebar collapsed" id="sidebar">
  <div class="sidebar-header">
    <a href="<%= root_path %>" class="sidebar-logo">
      <i class="ph-pen"></i>
      <span>Admin Panel</span>
    </a>
    <button class="sidebar-toggle d-block d-lg-none" id="sidebar-toggle" aria-label="Fechar menu">
      <i class="ph-x"></i>
    </button>
  </div>
  <div class="sidebar-content">
    <div class="sidebar-section">
      <div class="sidebar-section-title">Principal</div>
      <ul class="sidebar-menu">
        <li class="sidebar-menu-item">
          <a href="<%= g_admin_path %>" class="sidebar-menu-link has-tooltip" data-tooltip="Dashboard">
            <span class="sidebar-menu-icon"><i class="ph-house"></i></span>
            <span class="sidebar-menu-text">Dashboard</span>
            <span class="tooltip top">Dashboard</span>
          </a>
        </li>
        <% if can? :manage, IProduto%>
          <li class="sidebar-menu-item">
            <a href="<%= i_produtos_path %>" class="sidebar-menu-link has-tooltip" data-tooltip="Produtos">
              <span class="sidebar-menu-icon"><i class="ph-bag"></i></span>
              <span class="sidebar-menu-text">Produtos</span>
              <span class="tooltip top">Infoprodutos</span>
            </a>
          </li>
        <% end %>
        <% if can? :manage, ICurso%>
          <li class="sidebar-menu-item">
            <a href="<%= i_cursos_path %>" class="sidebar-menu-link has-tooltip" data-tooltip="Cursos">
              <span class="sidebar-menu-icon"><i class="ph-book"></i></span>
              <span class="sidebar-menu-text">Cursos</span>
              <span class="tooltip top">Cursos</span>
            </a>
          </li>
        <% end %>
        <% if can? :manage, GTipoUsuario %>
          <div class="sidebar-section-title">Usuários</div>
          <li class="sidebar-menu-item">
            <a href="<%= g_tipo_usuarios_path %>" class="sidebar-menu-link has-tooltip" data-tooltip="Tipos de Usuários">
              <span class="sidebar-menu-icon"><i class="ph-user-circle"></i></span>
              <span class="sidebar-menu-text">Tipos de Usuários</span>
              <span class="tooltip top">Tipos de Usuários</span>
            </a>
          </li>
        <% end %>
        <% if can? :manage, GTipoUsuario %>
          <li class="sidebar-menu-item">
            <a href="<%= users_path %>" class="sidebar-menu-link has-tooltip" data-tooltip="Gerenciar Usuários">
              <span class="sidebar-menu-icon"><i class="ph-address-book"></i></span>
              <span class="sidebar-menu-text">Gerenciar Usuários</span>
              <span class="tooltip top">Gerenciar Usuários</span>
            </a>
          <% end %>
        </li>
        <% if can? :manage, Segmento%>
          <div class="sidebar-section-title">Segmentos</div>
          <li class="sidebar-menu-item">
            <a href="<%= segmentos_path %>" class="sidebar-menu-link has-tooltip" data-tooltip="Segmentos">
              <span class="sidebar-menu-icon"><i class="ph-circles-three-plus"></i></span>
              <span class="sidebar-menu-text">Segmentos</span>
              <span class="tooltip top">Segmentos</span>
            </a>
          </li>
        <% end %>
      </ul>
      <% if can? :manage, GCategoria%>
        <div class="sidebar-section-title">Categorias</div>
        <li class="sidebar-menu-item">
          <a href="<%= g_categorias_path %>" class="sidebar-menu-link has-tooltip" data-tooltip="Categorias">
            <span class="sidebar-menu-icon"><i class="ph-folders"></i></span>
            <span class="sidebar-menu-text">Categorias</span>
            <span class="tooltip top">Categorias</span>
          </a>
        </li>
      <% end %>
      <% if can? :manage, IPromocao%>
        <div class="sidebar-section-title">Promoções</div>
        <li class="sidebar-menu-item">
          <a href="<%= i_promocoes_path %>" class="sidebar-menu-link has-tooltip" data-tooltip="Promoções">
            <span class="sidebar-menu-icon"><i class="ph-percent"></i></span>
            <span class="sidebar-menu-text">Promoções</span>
            <span class="tooltip top">Promoções</span>
          </a>
        </li>
      <% end %>
      <% if can? :manage, IPromocaoProduto%>
        <li class="sidebar-menu-item">
          <a href="<%= i_promocao_produtos_path %>" class="sidebar-menu-link has-tooltip" data-tooltip="Produtos em Promoção">
            <span class="sidebar-menu-icon"><i class="ph-tag"></i></span>
            <span class="sidebar-menu-text">Promoção Produtos</span>
            <span class="tooltip top">Promoção Produtos</span>
          </a>
        </li>
      <% end %>
      <div class="sidebar-section-title">Blog</div>
      <% if can? :manage, GBlogCategoria%>
        <li class="sidebar-menu-item">
          <a href="<%= g_blog_categorias_path %>" class="sidebar-menu-link has-tooltip" data-tooltip="Produtos em Promoção">
            <span class="sidebar-menu-icon"><i class="ph-book-open "></i></span>
            <span class="sidebar-menu-text">Blog</span>
            <span class="tooltip top">Blog</span>
          </a>
        </li>
      <% end %>
    </div>
  </div>
</aside>
<!-- Mobile Tooltip -->
<div class="mobile-tooltip" id="mobile-tooltip"></div>
