<header class="header">
  <button class="mobile-toggle" id="mobile-toggle" aria-label="Abrir menu">
    <i class="lucide-menu"></i>
  </button>
  <div class="header-actions">
    <div class="header-user">
      <!-- Dropdown do usuário -->
      <div class="dropdown">
        <button class="btn btn-link dropdown-toggle user-dropdown-btn" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
          <div class="header-user-info">
            <div class="header-user-name"><%= current_user.nome %></div>
            <div class="header-user-role"><%= current_user.g_tipo_usuario.nome %></div>
          </div>
          <i class="lucide-chevron-down ms-2"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
          <li><hr class="dropdown-divider"></li>
          <li>
            <%= button_to destroy_user_session_path, method: :delete, data: { confirm: "Deseja realmente sair?",turbo_method: :delete },  class: "dropdown-item logout-btn", form: { style: "display: inline;" } do %><i class="lucide-log-out me-2"></i>Sair
            <% end %>
          </li>
        </ul>
      </div>
    </div>
  </div>
</header>
<script>
  document.addEventListener("DOMContentLoaded", function () {
   // Função para confirmar logout
   const logoutButtons = document.querySelectorAll('.logout-btn');

   logoutButtons.forEach(button => {
     button.addEventListener('click', function(e) {
       const confirmed = confirm('Deseja realmente sair?');
       if (!confirmed) {
         e.preventDefault();
         return false;
       }
     });
   });

   // Fechar dropdown ao clicar fora
   document.addEventListener('click', function(e) {
     const dropdowns = document.querySelectorAll('.dropdown-menu.show');
     dropdowns.forEach(dropdown => {
       if (!dropdown.closest('.dropdown').contains(e.target)) {
         const bsDropdown = window.bootstrap.Dropdown.getInstance(dropdown.previousElementSibling);
         if (bsDropdown) {
           bsDropdown.hide();
         }
       }
     });
   });

   // Adicionar indicador de loading no logout
   const logoutForms = document.querySelectorAll('form[action*="sign_out"]');
   logoutForms.forEach(form => {
     form.addEventListener('submit', function() {
       const button = form.querySelector('.logout-btn');
       if (button) {
         button.innerHTML = '<i class="lucide-loader-2 me-2 animate-spin"></i>Saindo...';
         button.disabled = true;
       }
     });
   });
  });
</script>