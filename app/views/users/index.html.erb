<h1 class="my-4">Gerenciar Usuários</h1>
<div class="card">
  <div class="card-header">
    <h5 class="card-title mb-0">Usuários Cadastrados</h5>
  </div>
  <div class="card-body">
    <table class="table table-bordered table-striped">
      <thead>
        <tr>
          <th>Nome</th>
          <th>Email</th>
          <th>Tipo</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.nome %></td>
            <td><%= user.email %></td>
            <td><%= user.g_tipo_usuario&.nome || "Padrão" %></td>
            <td class="d-flex">
              <%= link_to "Editar", edit_user_path(user), class: "btn btn-warning btn-sm me-2" %>
              <%= button_to "Excluir", user, method: :delete, data: { confirm: "Tem certeza?" }, class: "btn btn-danger btn-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
